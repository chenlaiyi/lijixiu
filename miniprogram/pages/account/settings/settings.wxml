<view class="safe-page settings-page">
  <view class="settings-section">
    <text class="settings-section-title">账号</text>
    <button class="settings-row" bindtap="goPersonalInfo" hover-class="tap-feedback-active">
      <view class="settings-row-main">
        <view class="settings-icon-wrap"><image src="/assets/ui/profile-user.png" mode="aspectFit" /></view>
        <view class="settings-copy"><text class="settings-label">个人信息</text><text class="settings-desc">{{phoneText}}</text></view>
      </view>
      <image class="settings-arrow" src="/assets/ui/chevron-right.png" mode="aspectFit" />
    </button>
  </view>

  <view class="settings-section">
    <text class="settings-section-title">隐私与权限</text>
    <button class="settings-row" bindtap="openSystemSettings" hover-class="tap-feedback-active">
      <view class="settings-row-main">
        <view class="settings-icon-wrap"><image src="/assets/ui/admin.png" mode="aspectFit" /></view>
        <view class="settings-copy"><text class="settings-label">系统权限</text><text class="settings-desc">麦克风、相册和定位</text></view>
      </view>
      <image class="settings-arrow" src="/assets/ui/chevron-right.png" mode="aspectFit" />
    </button>
    <button class="settings-row" bindtap="openTerms" hover-class="tap-feedback-active">
      <view class="settings-row-main">
        <view class="settings-icon-wrap"><image src="/assets/ui/bill-check.png" mode="aspectFit" /></view>
        <view class="settings-copy"><text class="settings-label">用户协议</text><text class="settings-desc">服务使用与权益说明</text></view>
      </view>
      <image class="settings-arrow" src="/assets/ui/chevron-right.png" mode="aspectFit" />
    </button>
    <button class="settings-row" bindtap="openPrivacyContract" hover-class="tap-feedback-active">
      <view class="settings-row-main">
        <view class="settings-icon-wrap"><image src="/assets/ui/bill-check.png" mode="aspectFit" /></view>
        <view class="settings-copy"><text class="settings-label">隐私保护指引</text><text class="settings-desc">查看信息使用说明</text></view>
      </view>
      <image class="settings-arrow" src="/assets/ui/chevron-right.png" mode="aspectFit" />
    </button>
  </view>

  <view class="settings-section">
    <text class="settings-section-title">关于</text>
    <button class="settings-row" bindtap="showAbout" hover-class="tap-feedback-active">
      <view class="settings-row-main">
        <view class="settings-icon-wrap"><image src="/assets/logo-mark.png" mode="aspectFit" /></view>
        <view class="settings-copy"><text class="settings-label">关于立即修</text><text class="settings-desc">{{versionText}}</text></view>
      </view>
      <image class="settings-arrow" src="/assets/ui/chevron-right.png" mode="aspectFit" />
    </button>
  </view>

  <button class="settings-logout" bindtap="handleLogout" hover-class="button-hover">
    <image src="/assets/ui/logout.png" mode="aspectFit" />
    <text>退出登录</text>
  </button>
</view>

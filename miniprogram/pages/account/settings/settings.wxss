.settings-page {
  background: #f6f7f9;
}

.settings-section {
  margin-bottom: 16rpx;
  padding: 0 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
}

.settings-section-title {
  display: block;
  padding: 20rpx 0 12rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 800;
}

.settings-row {
  width: 100%;
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0;
  padding: 14rpx 0;
  color: #101828;
  background: transparent;
  border: 0;
  border-bottom: 1rpx solid #edf1f5;
  border-radius: 0;
  text-align: left;
}

.settings-row:last-child {
  border-bottom: 0;
}

.settings-row::after {
  border: 0;
}

.settings-row-main {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.settings-icon-wrap {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.settings-icon-wrap image {
  width: 30rpx;
  height: 30rpx;
}

.settings-copy {
  min-width: 0;
  flex: 1;
}

.settings-label,
.settings-desc {
  display: block;
  min-width: 0;
  word-break: break-all;
}

.settings-label {
  color: #101828;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
}

.settings-desc {
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.4;
}

.settings-arrow {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.settings-logout {
  width: 100%;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 8rpx 0 0;
  color: #b42318;
  background: #fef3f2;
  border: 1rpx solid #fecdca;
  border-radius: 14rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.settings-logout image {
  width: 30rpx;
  height: 30rpx;
}

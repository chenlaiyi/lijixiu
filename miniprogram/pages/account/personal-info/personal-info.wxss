.account-page {
  background: #f6f7f9;
}

.account-header,
.account-section {
  margin-bottom: 16rpx;
  padding: 22rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
}

.account-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.account-avatar {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #e7f8ef;
  border: 1rpx solid #bfe9d1;
  border-radius: 16rpx;
}

.account-avatar image {
  width: 48rpx;
  height: 48rpx;
}

.account-header-copy {
  min-width: 0;
  flex: 1;
}

.account-title,
.account-subtitle,
.section-title,
.section-desc {
  display: block;
}

.account-title {
  color: #101828;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
  word-break: break-all;
}

.account-subtitle {
  margin-top: 5rpx;
  color: #087443;
  font-size: 24rpx;
  font-weight: 800;
}

.section-heading {
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #edf1f5;
}

.section-title {
  color: #101828;
  font-size: 28rpx;
  font-weight: 900;
}

.section-desc {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.5;
}

.form-row,
.info-row {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #edf1f5;
}

.info-row:last-child {
  border-bottom: 0;
}

.field-label {
  width: 150rpx;
  flex-shrink: 0;
  color: #344054;
  font-size: 26rpx;
  font-weight: 800;
}

.field-input,
.field-value {
  min-width: 0;
  flex: 1;
  color: #101828;
  font-size: 26rpx;
  text-align: right;
}

.field-input {
  height: 72rpx;
}

.field-value {
  line-height: 1.45;
  word-break: break-all;
}

/* 2026-10-07 multi-role:多角色账号可在此切换当前身份 */
.role-switch-link {
  color: #087443;
  font-weight: 900;
  text-decoration: underline;
}

.field-value-note {
  color: #667085;
  font-size: 23rpx;
}

.account-alert {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 18rpx;
  color: #b42318;
  background: #fef3f2;
  border: 1rpx solid #fecdca;
  border-radius: 14rpx;
  font-size: 23rpx;
  line-height: 1.45;
}

.account-alert image {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.save-button {
  width: 100%;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 0;
  color: #ffffff;
  background: #087443;
  border: 1rpx solid #087443;
  border-radius: 14rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.save-button image {
  width: 30rpx;
  height: 30rpx;
}

.save-button[disabled] {
  color: #ffffff;
  background: #98a2b3;
  border-color: #98a2b3;
}

<view class="safe-page account-page">
  <view class="account-header">
    <view class="account-avatar">
      <image src="/assets/ui/profile-user.png" mode="aspectFit" />
    </view>
    <view class="account-header-copy">
      <text class="account-title">{{name || '未设置姓名'}}</text>
      <text class="account-subtitle">{{roleText}}</text>
    </view>
  </view>

  <view class="account-section">
    <view class="section-heading">
      <text class="section-title">基本信息</text>
      <text class="section-desc">姓名可修改，账号身份由平台管理</text>
    </view>

    <view class="form-row">
      <text class="field-label">姓名</text>
      <input class="field-input" value="{{name}}" maxlength="50" placeholder="请输入姓名" bindinput="onNameInput" />
    </view>
    <view class="info-row">
      <text class="field-label">手机号</text>
      <text class="field-value">{{phoneText}}</text>
    </view>
    <view class="info-row">
      <text class="field-label">账号角色</text>
      <text class="field-value">{{roleText}}</text>
    </view>
    <view class="info-row">
      <text class="field-label">账号编号</text>
      <text class="field-value">{{accountIdText}}</text>
    </view>
  </view>

  <view wx:if="{{errorText}}" class="account-alert">
    <image src="/assets/ui/bill-file.png" mode="aspectFit" />
    <text>{{errorText}}</text>
  </view>

  <button class="save-button" bindtap="saveProfile" loading="{{saving}}" disabled="{{loading || saving}}" hover-class="button-hover">
    <image src="/assets/ui/bill-check.png" mode="aspectFit" />
    <text>{{saving ? '保存中' : '保存个人信息'}}</text>
  </button>
</view>

.index-page {
  min-height: 100vh;
  padding: 88rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  box-sizing: border-box;
  color: #1d2939;
  background: #f6f8fb;
}

.brand-stack {
  min-width: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  text-align: center;
}

.logo-mark {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  box-shadow: none;
}

.logo-image {
  width: 100%;
  height: 100%;
  display: block;
}

.brand-name {
  display: block;
  color: #101828;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.18;
}

.brand-desc {
  display: block;
  color: #667085;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.4;
}

.loading-row {
  min-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.35;
}

.loading-ring {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid #d0d5dd;
  border-top-color: #087443;
  border-radius: 50%;
  animation: loading-spin 0.82s linear infinite;
}

.loading-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.retry-btn {
  min-width: 196rpx;
  height: 76rpx;
  padding: 0 22rpx;
  color: #fff;
  background: #087443;
  border-radius: 14rpx;
  font-size: 25rpx;
}

.retry-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.retry-hint {
  display: block;
  color: #98a2b3;
  font-size: 22rpx;
  text-align: center;
  line-height: 1.5;
  max-width: 480rpx;
}

.contact-btn {
  min-width: 196rpx;
  height: 68rpx;
  padding: 0 22rpx;
  color: #344054;
  background: #fff;
  border: 1rpx solid #d0d5dd;
  border-radius: 14rpx;
  font-size: 24rpx;
}

@keyframes loading-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.claim-page { background: #f6f7f9; }
.claim-summary, .claim-form, .existing-ticket { margin-bottom: 16rpx; padding: 22rpx; background: #fff; border: 1rpx solid #e5e7eb; border-radius: 14rpx; }
.summary-head { display: flex; align-items: center; gap: 16rpx; }
.summary-icon { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: #e7f8ef; border: 1rpx solid #bfe9d1; border-radius: 14rpx; }
.summary-icon image { width: 34rpx; height: 34rpx; }
.summary-copy { min-width: 0; flex: 1; }
.summary-title, .summary-desc { display: block; word-break: break-all; }
.summary-title { color: #101828; font-size: 27rpx; font-weight: 900; }
.summary-desc { margin-top: 5rpx; color: #667085; font-size: 22rpx; }
.summary-status { flex-shrink: 0; padding: 7rpx 12rpx; color: #067647; background: #ecfdf3; border-radius: 9rpx; font-size: 20rpx; font-weight: 800; }
.summary-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #edf1f5; }
.summary-grid view { min-width: 0; padding: 14rpx; background: #f8fafc; border-radius: 12rpx; }
.summary-grid text { display: block; color: #667085; font-size: 21rpx; }
.summary-grid text:last-child { margin-top: 5rpx; color: #101828; font-size: 27rpx; font-weight: 900; word-break: break-all; }
.form-heading { padding-bottom: 18rpx; border-bottom: 1rpx solid #edf1f5; }
.form-heading text { display: block; color: #101828; font-size: 28rpx; font-weight: 900; }
.form-heading text:last-child { margin-top: 5rpx; color: #667085; font-size: 22rpx; font-weight: 400; }
.form-field { padding: 20rpx 0; border-bottom: 1rpx solid #edf1f5; }
.form-field:last-child { border-bottom: 0; }
.field-label { display: block; margin-bottom: 12rpx; color: #344054; font-size: 25rpx; font-weight: 800; }
.picker-value { min-height: 76rpx; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 0 16rpx; color: #101828; background: #f8fafc; border: 1rpx solid #d0d5dd; border-radius: 12rpx; font-size: 25rpx; }
.picker-value image { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.description-field { position: relative; }
.description-field textarea { width: 100%; height: 220rpx; box-sizing: border-box; padding: 16rpx; color: #101828; background: #f8fafc; border: 1rpx solid #d0d5dd; border-radius: 12rpx; font-size: 25rpx; line-height: 1.55; }
.input-count { display: block; margin-top: 8rpx; color: #98a2b3; font-size: 20rpx; text-align: right; }
.claim-alert { display: flex; align-items: flex-start; gap: 12rpx; margin-bottom: 16rpx; padding: 18rpx; color: #b42318; background: #fef3f2; border: 1rpx solid #fecdca; border-radius: 14rpx; font-size: 23rpx; line-height: 1.45; }
.claim-alert image { width: 30rpx; height: 30rpx; flex-shrink: 0; }
.submit-claim { width: 100%; height: 82rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; margin: 0; color: #fff; background: #087443; border: 1rpx solid #087443; border-radius: 14rpx; font-size: 27rpx; font-weight: 900; }
.submit-claim image { width: 30rpx; height: 30rpx; }
.claim-empty { min-height: 420rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; padding: 24rpx; color: #667085; text-align: center; background: #fff; border: 1rpx solid #e5e7eb; border-radius: 14rpx; font-size: 24rpx; }
.claim-empty > image { width: 70rpx; height: 70rpx; opacity: .7; }
.claim-empty button { min-width: 190rpx; height: 72rpx; margin: 4rpx 0 0; padding: 0 20rpx; color: #087443; background: #fff; border: 1rpx solid #bfe9d1; border-radius: 12rpx; font-size: 24rpx; }
.existing-ticket { display: flex; align-items: flex-start; gap: 14rpx; color: #175cd3; background: #eff4ff; border-color: #b2ccff; }
.existing-ticket > image { width: 34rpx; height: 34rpx; flex-shrink: 0; }
.existing-title, .existing-desc { display: block; }
.existing-title { font-size: 26rpx; font-weight: 900; }
.existing-desc { margin-top: 5rpx; font-size: 22rpx; line-height: 1.45; }

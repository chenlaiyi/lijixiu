.warranty-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx; color: #101828; background: #f7f8fa; }
.page-head { padding: 4rpx 2rpx 20rpx; }.page-title { display: block; font-size: 32rpx; font-weight: 800; }.page-desc { display: block; margin-top: 8rpx; color: #667085; font-size: 21rpx; line-height: 1.5; }
.warranty-list { display: flex; flex-direction: column; gap: 16rpx; }.warranty-item { padding: 24rpx; background: #fff; border: 1rpx solid #d0d5dd; border-left: 6rpx solid #087443; border-radius: 12rpx; }
.warranty-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 23rpx; font-weight: 800; }.status { flex-shrink: 0; padding: 6rpx 10rpx; color: #067647; background: #ecfdf3; border-radius: 7rpx; font-size: 18rpx; }.status.expired { color: #667085; background: #f2f4f7; }
.amount { display: block; margin-top: 18rpx; font-size: 29rpx; font-weight: 800; }.warranty-days { display: block; margin-top: 12rpx; color: #667085; font-size: 20rpx; }
.countdown-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 18rpx; padding: 16rpx; background: #f3fbf7; border: 1rpx solid #d7f1e2; border-radius: 12rpx; }
.countdown-copy { min-width: 0; flex: 1; }
.countdown-label, .countdown-date { display: block; }
.countdown-label { color: #087443; font-size: 23rpx; font-weight: 900; }
.countdown-date { margin-top: 5rpx; color: #667085; font-size: 20rpx; line-height: 1.35; }
.countdown-value { display: flex; align-items: baseline; gap: 5rpx; flex-shrink: 0; color: #087443; }
.countdown-value text:first-child { font-size: 38rpx; font-weight: 900; line-height: 1; }
.countdown-value text:last-child { font-size: 21rpx; font-weight: 800; }
.warranty-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #eaecf0; }
.claim-status { min-width: 0; flex: 1; color: #475467; font-size: 21rpx; }
.claim-button { min-width: 238rpx; max-width: 100%; height: 72rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; margin: 0 0 0 auto; padding: 0 18rpx; color: #fff; background: #087443; border: 1rpx solid #087443; border-radius: 12rpx; font-size: 24rpx; font-weight: 800; }
.claim-button image { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.claim-button.disabled { color: #667085; background: #f2f4f7; border-color: #e4e7ec; }
.empty-state { min-height: 380rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; color: #667085; }
.retry-button { min-width: 190rpx; height: 72rpx; margin: 0; padding: 0 20rpx; color: #087443; background: #fff; border: 1rpx solid #bfe9d1; border-radius: 12rpx; font-size: 24rpx; }

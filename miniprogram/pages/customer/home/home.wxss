.home {
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f8faf9 0%, #f5f7f8 42%, #f6f7f9 100%);
}

.home-hero {
  position: relative;
  overflow: hidden;
  padding: 22rpx 20rpx 20rpx;
  color: #101828;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 18rpx;
  box-shadow: 0 6rpx 16rpx rgba(16, 24, 40, 0.04);
}

.home-hero::before {
  content: "";
  position: absolute;
  top: 0;
  left: 24rpx;
  right: 24rpx;
  height: 5rpx;
  background: #087443;
  border-radius: 0 0 999rpx 999rpx;
  opacity: 0.86;
}

.home-hero-head {
  position: relative;
  display: flex;
  flex-wrap: nowrap;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.brand-kicker {
  display: block;
  color: #101828;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.2;
  word-break: break-all;
}

.brand-sub {
  display: block;
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.35;
  word-break: break-all;
}

.home-hero-copy {
  position: relative;
  margin-top: 22rpx;
}

.hero-kicker {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 13rpx;
  color: #087443;
  background: #e7f8ef;
  border: 1rpx solid #bfe9d1;
  border-radius: 10rpx;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1;
}

.hello {
  display: block;
  min-width: 0;
  margin-top: 14rpx;
  color: #101828;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.18;
  word-break: break-all;
}

.hello-sub {
  display: block;
  margin-top: 8rpx;
  max-width: 590rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.42;
  word-break: break-all;
}

.hero-media-strip {
  display: flex;
  flex-wrap: nowrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.hero-media-pill {
  min-width: 0;
  flex: 1;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #087443;
  background: rgba(243, 251, 247, 0.92);
  border: 1rpx solid #d7f1e2;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.hero-media-pill.tone-image {
  color: #175cd3;
  background: #eff4ff;
  border-color: #d1e0ff;
}

.hero-media-pill.tone-video {
  color: #b54708;
  background: #fff7ed;
  border-color: #fed7aa;
}

.hero-media-pill image {
  width: 23rpx;
  height: 23rpx;
  display: block;
  flex-shrink: 0;
}

.hero-media-pill text {
  min-width: 0;
  overflow: hidden;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-btn {
  min-width: 112rpx;
  max-width: 164rpx;
  height: 62rpx;
  flex-shrink: 0;
  margin: 0;
  padding: 0 14rpx;
  color: #087443;
  background: #fff;
  border: 1rpx solid #bfe9d1;
  border-radius: 13rpx;
  font-size: 23rpx;
}

.hero-actions {
  position: relative;
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.hero-summary {
  position: relative;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  padding: 11rpx 12rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(16, 24, 40, 0.08);
  border-radius: 14rpx;
}

.hero-summary.pay {
  background: #fff7ed;
  border-color: #fed7aa;
}

.hero-summary.progress {
  background: #eff4ff;
  border-color: #b2ccff;
}

.hero-summary.sync {
  background: #f8fafc;
  border-color: #e5e7eb;
}

.hero-summary.ready {
  background: #f3fbf7;
  border-color: #bfe9d1;
}

.hero-summary.failed {
  background: #fffbeb;
  border-color: #fde68a;
}

.hero-summary-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #ffffff;
  border: 1rpx solid rgba(16, 24, 40, 0.08);
  border-radius: 14rpx;
}

.hero-summary-icon {
  width: 29rpx;
  height: 29rpx;
  display: block;
}

.hero-summary-copy {
  min-width: 0;
  flex: 1;
}

.hero-summary-label {
  display: block;
  color: #667085;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
  word-break: break-all;
}

.hero-summary-title {
  display: block;
  margin-top: 5rpx;
  color: #101828;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-all;
}

.hero-summary-desc {
  display: block;
  margin-top: 3rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-summary-arrow {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  opacity: 0.62;
}

.repair-main-btn,
.orders-main-btn,
.profile-btn,
.pay-order-btn,
.empty-action {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
  line-height: 1;
  text-align: center;
}

.repair-main-btn,
.orders-main-btn {
  min-width: 0;
  height: 104rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  font-weight: 900;
}

.repair-main-btn {
  flex: 1;
  color: #fff;
  background: linear-gradient(135deg, #087443 0%, #0b7a51 100%);
  box-shadow: 0 10rpx 22rpx rgba(8, 116, 67, 0.18);
}

.orders-main-btn {
  position: relative;
  width: 128rpx;
  flex-shrink: 0;
  color: #344054;
  background: #ffffff;
  border: 1rpx solid #d0d5dd;
  box-shadow: 0 6rpx 16rpx rgba(16, 24, 40, 0.05);
}

.hero-order-badge {
  position: absolute;
  top: -6rpx;
  right: -4rpx;
  z-index: 2;
  min-width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  color: #ffffff;
  background: #175cd3;
  border: 2rpx solid #ffffff;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
  box-shadow: 0 4rpx 10rpx rgba(16, 24, 40, 0.16);
}

.hero-order-badge.pay {
  background: #d92d20;
}

.hero-order-badge.progress {
  background: #175cd3;
}

.hero-order-badge text {
  display: block;
  min-width: 0;
  overflow: hidden;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-main-action {
  width: 100%;
  height: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13rpx;
}

.hero-main-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 13rpx;
}

.hero-main-copy {
  min-width: 0;
  flex: 1;
  text-align: left;
}

.hero-main-arrow {
  width: 26rpx;
  height: 26rpx;
  display: block;
  flex-shrink: 0;
  filter: brightness(0) invert(1);
  opacity: 0.78;
}

.hero-main-title,
.hero-main-desc {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-main-title {
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.2;
}

.hero-main-desc {
  margin-top: 5rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-order-action {
  width: 100%;
  height: 100%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
}

.hero-order-action text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  color: #344054;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-order-action .hero-order-title {
  color: #101828;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1;
}

.hero-order-action .hero-order-sub {
  color: #667085;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1;
}

.hero-action-icon {
  width: 31rpx;
  height: 31rpx;
  flex-shrink: 0;
  display: block;
}

.hero-action-icon.dark {
  opacity: 0.82;
}

.promise-row {
  position: relative;
  display: flex;
  flex-wrap: nowrap;
  gap: 0;
  margin-top: 12rpx;
  padding: 7rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(16, 24, 40, 0.07);
  border-radius: 14rpx;
}

.promise-item {
  min-width: 0;
  flex: 1;
  min-height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 7rpx;
  padding: 6rpx 8rpx;
  color: #344054;
  background: transparent;
  border: none;
  border-radius: 0;
}

.promise-item + .promise-item {
  border-left: 1rpx solid rgba(16, 24, 40, 0.07);
}

.promise-item.tone-quote {
  color: #087443;
}

.promise-item.tone-material {
  color: #175cd3;
}

.promise-item.tone-pay {
  color: #b54708;
}

.promise-icon-wrap {
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #ffffff;
  border: 1rpx solid rgba(16, 24, 40, 0.08);
  border-radius: 10rpx;
}

.promise-copy {
  min-width: 0;
  flex: 1;
}

.promise-title,
.promise-desc {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.promise-title {
  color: #101828;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.promise-desc {
  margin-top: 2rpx;
  color: #667085;
  font-size: 16rpx;
  font-weight: 800;
  line-height: 1.2;
}

.promise-icon {
  width: 20rpx;
  height: 20rpx;
  display: block;
}

.home-status-dock {
  margin-top: 16rpx;
  position: relative;
  overflow: hidden;
  padding: 18rpx;
  color: #344054;
  background: #ffffff;
  border: 1rpx solid #d7f1e2;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 20rpx rgba(16, 24, 40, 0.045);
}

.home-status-dock::before {
  content: "";
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 6rpx;
  background: #087443;
  border-radius: 0 999rpx 999rpx 0;
}

.home-status-dock.pay {
  background: #fffaf5;
  border-color: #fed7aa;
  box-shadow: 0 9rpx 22rpx rgba(180, 83, 9, 0.08);
}

.home-status-dock.pay::before {
  background: #b54708;
}

.home-status-dock.progress {
  background: #f5f9ff;
  border-color: #b2ccff;
  box-shadow: 0 8rpx 20rpx rgba(23, 92, 211, 0.07);
}

.home-status-dock.progress::before {
  background: #175cd3;
}

.home-status-dock.failed {
  background: #fffbeb;
  border-color: #fde68a;
}

.home-status-dock.failed::before {
  background: #b54708;
}

.home-status-dock.ready {
  background: #f7fbf9;
  border-color: #bfe9d1;
}

.status-dock-head {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.status-dock-main {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-dock-icon-wrap {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #ffffff;
  border: 1rpx solid rgba(16, 24, 40, 0.08);
  border-radius: 14rpx;
}

.status-dock-icon {
  width: 31rpx;
  height: 31rpx;
  display: block;
}

.status-dock-copy {
  min-width: 0;
  flex: 1;
}

.status-dock-label {
  display: block;
  color: #667085;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.status-dock-title {
  display: block;
  min-width: 0;
  margin-top: 4rpx;
  color: #101828;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-sync-pill {
  max-width: 186rpx;
  height: 42rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  padding: 0 10rpx;
  color: #175cd3;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid rgba(23, 92, 211, 0.18);
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.status-sync-pill image {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
}

.status-sync-pill text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-dock-desc {
  position: relative;
  display: block;
  margin-top: 10rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.42;
  word-break: break-all;
}

.status-highlight-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 10rpx;
  background: rgba(255, 255, 255, 0.68);
  border: 1rpx solid rgba(16, 24, 40, 0.07);
  border-radius: 14rpx;
}

.status-highlight-pill {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #087443;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1;
}

.home-status-dock.pay .status-highlight-pill {
  color: #b54708;
}

.home-status-dock.progress .status-highlight-pill {
  color: #175cd3;
}

.status-highlight-pill image {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.status-highlight-pill text,
.status-highlight-count {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-highlight-count {
  flex-shrink: 0;
  max-width: 190rpx;
  color: #667085;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1;
}

.status-dock-foot {
  position: relative;
  display: flex;
  align-items: stretch;
  gap: 10rpx;
  margin-top: 14rpx;
}

.status-quick-row {
  min-width: 0;
  flex: 1;
  display: flex;
  gap: 8rpx;
}

.status-quick-card {
  min-width: 0;
  flex: 1;
  min-height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  padding: 0 13rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(16, 24, 40, 0.07);
  border-radius: 13rpx;
}

.status-quick-card.progress {
  color: #087443;
  background: #f3fbf7;
  border-color: #bfe9d1;
}

.status-quick-card.pay {
  color: #b54708;
  background: #fff7ed;
  border-color: #fed7aa;
}

.status-quick-label,
.status-quick-num {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-quick-label {
  color: #667085;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.status-quick-num {
  color: currentColor;
  font-size: 33rpx;
  font-weight: 900;
  line-height: 1;
}

.home-status-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.home-status-title-wrap {
  min-width: 0;
  flex: 1;
}

.home-status-title {
  display: block;
  color: #101828;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
  word-break: break-all;
}

.home-status-desc {
  display: block;
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.4;
  word-break: break-all;
}

.status-chip {
  min-width: 112rpx;
  max-width: 220rpx;
  height: 46rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 0 12rpx;
  color: #175cd3;
  background: #eff4ff;
  border: 1rpx solid #b2ccff;
  border-radius: 12rpx;
  font-size: 21rpx;
  font-weight: 900;
}

.status-chip text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-chip-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.stats-row {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.status-metric-row {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}

.status-metric {
  min-width: 0;
  flex: 1;
  min-height: 74rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 12rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
}

.status-metric.progress {
  background: #f3fbf7;
  border-color: #d7f1e2;
}

.status-metric.pay {
  background: #fff7ed;
  border-color: #fed7aa;
}

.status-metric-icon-wrap {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #ffffff;
  border: 1rpx solid rgba(16, 24, 40, 0.08);
  border-radius: 12rpx;
}

.status-metric-icon {
  width: 26rpx;
  height: 26rpx;
  display: block;
}

.status-metric-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx;
}

.status-metric-label,
.status-metric-num {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-metric-label {
  color: #667085;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.2;
}

.status-metric-num {
  color: #087443;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.status-metric.pay .status-metric-num {
  color: #b54708;
}

.stat-card {
  flex: 1;
  min-width: 0;
  min-height: 98rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
}

.stat-card.highlight {
  background: #fff7ed;
  border-color: #fed7aa;
}

.stat-icon {
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
}

.stat-copy {
  min-width: 0;
  flex: 1;
}

.stat-num {
  display: block;
  min-width: 0;
  max-width: 100%;
  color: #087443;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.12;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.stat-label {
  display: block;
  margin-top: 4rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.3;
  word-break: break-all;
}

.home-notice-card {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 12rpx;
  margin-top: 12rpx;

.order-page {
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
  background: #f6f7f9;
}

.order-header {
  padding: 22rpx;
  color: #101828;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  box-shadow: none;
}

.order-header-copy {
  min-width: 0;
}

.order-step-row {
  display: flex;
  gap: 8rpx;
  margin-top: 18rpx;
}

.order-step {
  min-width: 0;
  height: 50rpx;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  color: #667085;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.order-step.active {
  color: #087443;
  background: #f3fbf7;
  border-color: #bfe9d1;
}

.order-step text {
  display: block;
  min-width: 0;
  overflow: hidden;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-kicker {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  max-width: 100%;
  padding: 0 14rpx;
  overflow: hidden;
  color: #087443;
  background: #e7f8ef;
  border: 1rpx solid #bfe9d1;
  border-radius: 10rpx;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-title {
  display: block;
  margin-top: 14rpx;
  color: #101828;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.18;
  word-break: break-all;
}

.order-subtitle {
  display: block;
  margin-top: 7rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
}

.form-card {
  margin-top: 12rpx;
  padding: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  box-shadow: none;
}

.form-item {
  margin-bottom: 18rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-item.active .input,
.form-item.active .picker-value,
.form-item.active .textarea {
  border-color: #087443;
  box-shadow: 0 0 0 4rpx rgba(8, 116, 67, 0.08);
}

.form-item.error .input,
.form-item.error .textarea {
  border-color: #f04438;
  box-shadow: 0 0 0 4rpx rgba(240, 68, 56, 0.08);
}

.selector-grid {
  display: flex;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.selector-item {
  min-width: 0;
  flex: 1;
  margin-bottom: 0;
}

.label-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 9rpx;
}

.label-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.label {
  display: block;
  min-width: 0;
  color: #344054;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.3;
  word-break: break-all;
}

.label-note {
  min-width: 0;
  flex: 1;
  color: #98a2b3;
  font-size: 21rpx;
  line-height: 1.3;
  text-align: right;
  word-break: break-all;
}

.value {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #087443;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.input,
.picker-value,
.textarea {
  width: 100%;
  min-width: 0;
  color: #101828;
  background: #ffffff;
  border: 1rpx solid #d0d5dd;
  border-radius: 14rpx;
  font-size: 29rpx;
}

.field-placeholder {
  color: #98a2b3;
}

.input,
.picker-value {
  height: 72rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 18rpx;
  line-height: 1.25;
}

.picker-text {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #101828;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-picker-value {
  height: auto;
  min-height: 92rpx;
  padding-top: 14rpx;
  padding-bottom: 14rpx;
}

.address-picker-copy {
  min-width: 0;
  flex: 1;
}

.address-picker-main,
.address-picker-code,
.routing-label,
.routing-value {
  display: block;
}

.address-picker-main {
  color: #101828;
  font-size: 24rpx;
  line-height: 1.45;
}

.address-picker-code {
  margin-top: 6rpx;
  color: #667085;
  font-size: 19rpx;
}

.address-routing {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eaecf0;
}

.routing-label {
  color: #667085;
  font-size: 20rpx;
}

.routing-value {
  margin-top: 5rpx;
  color: #101828;
  font-size: 22rpx;
  line-height: 1.35;
}

.picker-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  opacity: 0.66;
}

.fault-card {
  margin: 4rpx -2rpx 22rpx;
  padding: 2rpx;
}

.textarea {
  height: 148rpx;
  padding: 17rpx 18rpx;
  line-height: 1.5;
  word-break: break-all;
}

.desc-tools-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
}

.media-hint,
.count,
.field-tip {
  color: #98a2b3;
  font-size: 22rpx;
  line-height: 1.45;
}

.media-hint {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.count {
  flex-shrink: 0;
}

.field-tip {
  display: block;
  margin-top: 8rpx;
  word-break: break-all;
}

.field-tip.warning {
  color: #b54708;
}

.options-failed {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  background: #fff7ed;
  border: 1rpx solid #fedf89;
  border-radius: 10rpx;
}

.options-retry {
  flex-shrink: 0;
  padding: 0 22rpx;
  height: 56rpx;
  line-height: 56rpx;
  color: #b54708;
  background: #fff;
  border: 1rpx solid #f79009;
  border-radius: 28rpx;
  font-size: 23rpx;
}

.field-tip.error {
  color: #b42318;
  font-weight: 800;
}

.media-actions {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
}

.media-btn {
  min-width: 0;
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  color: #087443;
  background: #f3fbf7;
  border: 1rpx solid #bfe9d1;
  border-radius: 12rpx;
  font-size: 23rpx;
  font-weight: 900;
}

.media-btn.image {
  color: #175cd3;
  background: #eff4ff;
  border-color: #b2ccff;
}

.media-btn.video {
  color: #b54708;
  background: #fff7ed;
  border-color: #fed7aa;
}

.media-btn.recording {
  color: #ffffff;
  background: #dc6803;
  border-color: #dc6803;
}

.media-btn text {
  min-width: 0;
  overflow: hidden;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.media-btn-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
  flex-shrink: 0;
}

.media-count-row {
  display: flex;
  gap: 8rpx;
  margin-top: 10rpx;
}

.media-count-row text {
  min-width: 0;
  flex: 1;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #667085;
  background: #f8fafc;
  border: 1rpx solid #edf1f5;
  border-radius: 11rpx;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.media-list {
  margin-top: 14rpx;
}

.media-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  margin-bottom: 10rpx;
  padding: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #edf1f5;
  border-radius: 14rpx;
}

.media-item:last-child {
  margin-bottom: 0;
}

.media-icon-wrap {
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.media-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
}

.media-info {
  min-width: 0;
  flex: 1;
}

.media-type {
  display: inline-flex;
  max-width: 100%;
  margin-right: 8rpx;
  padding: 5rpx 10rpx;
  overflow: hidden;
  color: #175cd3;
  background: #eff4ff;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.media-name {
  display: inline;
  color: #344054;
  font-size: 23rpx;
  line-height: 1.4;
  word-break: break-all;
}

.media-duration {
  display: block;
  margin-top: 4rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.3;
}

.media-remove {
  width: 86rpx;
  height: 58rpx;
  flex-shrink: 0;
  color: #b42318;
  background: #fef3f2;
  border: 1rpx solid #fecdca;
  border-radius: 12rpx;
  font-size: 0;
}

.media-remove .mini-action-content {
  gap: 0;
}

.media-remove .mini-action-icon {
  width: 28rpx;
  height: 28rpx;
}

.media-remove text {
  display: none;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #e5e7eb;
  box-shadow: none;
}

.submit-copy {
  min-width: 0;
  flex: 1;
}

.submit-label {
  display: block;
  color: #667085;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
}

.submit-category {
  display: block;
  margin-top: 5rpx;
  overflow: hidden;
  color: #101828;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submit-btn {
  width: 204rpx;
  height: 76rpx;
  flex-shrink: 0;
  padding: 0 18rpx;
  color: #ffffff;
  background: #087443;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.submit-btn text {
  min-width: 0;
  overflow: hidden;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submit-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.privacy-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(15, 23, 42, 0.48);
}

.privacy-dialog {
  width: 100%;
  box-sizing: border-box;
  max-height: calc(100vh - 120rpx);
  overflow-y: auto;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 14rpx 14rpx 0 0;
  box-shadow: none;
}

.privacy-title {
  display: block;
  color: #101828;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-all;
}

.privacy-desc {
  display: block;
  margin-top: 14rpx;
  color: #475467;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.privacy-link {
  color: #175cd3;
  font-weight: 900;
}

.privacy-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.privacy-secondary,
.privacy-primary {
  min-width: 0;
  flex: 1;
  height: 80rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
  font-weight: 900;
}

.privacy-secondary {
  color: #344054;
  background: #f2f4f7;
}

.privacy-primary {
  color: #ffffff;
  background: #087443;
}

.privacy-secondary text,
.privacy-primary text {
  min-width: 0;
  overflow: hidden;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Order polish pass. */
.order-page {
  background: #f6f7f9;
}

.order-header,
.form-card,
.fault-card,
.privacy-dialog {
  background: #ffffff;
  border-color: #e5e7eb;
  box-shadow: none;
}

.textarea,
.input,
.picker-value,
.media-item {
  background: #f8fafc;
  border-color: #e5e7eb;
}

.media-actions {
  gap: 10rpx;
}

.media-btn {
  background: #ffffff;
  border-color: #d0d5dd;
  box-shadow: none;
}

.media-btn.audio,
.media-btn.image,
.media-btn.video {
  background: #ffffff;
  border-color: #d0d5dd;
}

.submit-bar {
  box-shadow: none;
}

.submit-btn {
  box-shadow: none;
}
.safe-page.order-page .submit-bar {
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 70;
  min-height: 104rpx;
  padding: 12rpx 24rpx;
}
.safe-page.order-page { padding-bottom: calc(300rpx + env(safe-area-inset-bottom)); }
.form-submit-section { padding: 24rpx 0; }
.safe-page.order-page .form-submit-button { width: 100%; min-height: 88rpx; padding: 20rpx; background: #087443; color: #fff; font-size: 32rpx; font-weight: 700; border-radius: 14rpx; }

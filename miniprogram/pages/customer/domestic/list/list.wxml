<view class="domestic-page">
  <view class="service-switch">
    <button class="switch-item {{serviceType === 'maternity' ? 'active maternity' : ''}}" data-type="maternity" bindtap="switchType">月嫂</button>
    <button class="switch-item {{serviceType === 'nanny' ? 'active nanny' : ''}}" data-type="nanny" bindtap="switchType">保姆</button>
  </view>

  <view class="domestic-intro">
    <view class="intro-symbol {{serviceType}}">
      <image src="{{serviceType === 'maternity' ? '/assets/ui/profile-user.png' : '/assets/categories/cleaning.png'}}" mode="aspectFit" />
    </view>
    <view class="intro-copy">
      <text class="intro-title">{{title}}</text>
      <text class="intro-desc">{{subtitle}}</text>
    </view>
    <button class="publish-button" bindtap="publishDemand">发布需求</button>
  </view>

  <view wx:if="{{myDemands.length}}" class="demand-summary">
    <view class="list-head"><text>我的需求</text><text class="list-count">最近 {{myDemands.length}} 条</text></view>
    <view class="demand-row" wx:for="{{myDemands}}" wx:key="id"><view><text class="demand-name">#{{item.id}} {{item.description}}</text><text class="demand-date">开始时间 {{item.service_start || '待确认'}}</text></view><text class="demand-status">{{item.statusText}}</text></view>
  </view>

  <view class="list-head">
    <text>可匹配人员</text>
    <text class="list-count">{{workers.length}} 人</text>
  </view>

  <view wx:if="{{loading}}" class="state-panel">加载中…</view>
  <view wx:elif="{{failed}}" class="state-panel warning">
    <text>加载失败</text>
    <button bindtap="loadWorkers">重试</button>
  </view>
  <view wx:elif="{{workers.length === 0}}" class="state-panel">
    <text>暂时没有公开档案</text>
    <text>提交需求后由门店为您匹配</text>
  </view>

  <view wx:else class="worker-list">
    <view class="worker-card" wx:for="{{workers}}" wx:key="id" data-id="{{item.id}}" bindtap="openWorker" hover-class="worker-card-active">
      <image wx:if="{{item.avatar}}" class="worker-avatar" src="{{item.avatar}}" mode="aspectFill" />
      <view wx:else class="worker-avatar fallback">{{item.initial}}</view>
      <view class="worker-main">
        <view class="worker-title-row">
          <text class="worker-name">{{item.name}}</text>
          <text class="worker-price">{{item.priceText}}</text>
        </view>
        <text class="worker-meta">从业 {{item.years_experience}} 年 · 服务 {{item.service_count}} 次 · {{item.rating}} 分</text>
        <view class="worker-tags">
          <text wx:for="{{item.skills}}" wx:key="*this">{{item}}</text>
          <text class="verified" wx:if="{{item.verifiedCount}}">{{item.verifiedCount}}项已核验</text>
        </view>
        <text class="worker-availability">{{item.availability_text || '档期请咨询门店'}}</text>
      </view>
      <image class="worker-arrow" src="/assets/ui/chevron-right.png" mode="aspectFit" />
    </view>
  </view>
</view>

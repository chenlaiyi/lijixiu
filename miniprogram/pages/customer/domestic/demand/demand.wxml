<view class="demand-page">
  <view class="demand-head {{serviceType}}">
    <text class="demand-title">{{title}}</text>
    <text class="demand-desc">填写服务选项并提交预约，门店联系确认后匹配人员</text>
  </view>

  <view class="reservation-notice">这是家政服务预约申请，资料用于门店联系和服务匹配，不公开展示、不支持转发。其他要求可在门店联系时沟通。</view>

  <view class="form-section">
    <text class="section-title">联系与服务信息</text>
    <view class="field"><text>联系人</text><input maxlength="50" value="{{form.contactName}}" data-field="contactName" bindinput="inputField" placeholder="怎么称呼您" /></view>
    <view class="field"><text>联系电话</text><input type="number" maxlength="11" value="{{form.contactPhone}}" data-field="contactPhone" bindinput="inputField" placeholder="用于沟通匹配" /></view>
    <view class="field vertical"><address-fields value="{{addressValue}}" bindchange="addressChange" /></view>
    <view class="field"><text>开始日期</text><picker mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="dateChange"><view class="picker-value">{{form.startDate || '请选择'}}</view></picker></view>
    <view class="budget-row"><view class="field"><text>预算最低</text><input type="digit" value="{{form.budgetMin}}" data-field="budgetMin" bindinput="inputField" placeholder="元" /></view><view class="field"><text>预算最高</text><input type="digit" value="{{form.budgetMax}}" data-field="budgetMax" bindinput="inputField" placeholder="元" /></view></view>
  </view>

  <view class="form-section" wx:if="{{serviceType === 'maternity'}}">
    <text class="section-title">月嫂需求</text>
    <view class="field"><text>预产/出生日期</text><picker mode="date" value="{{form.expectedDate}}" data-field="expectedDate" bindchange="dateChange"><view class="picker-value">{{form.expectedDate || '请选择'}}</view></picker></view>
    <view class="field"><text>服务周期</text><picker range="{{cycleOptions}}" bindchange="cycleChange"><view class="picker-value">{{form.cycleDays}} 天</view></picker></view>
    <view class="field"><text>是否住家</text><switch color="#087443" checked="{{form.liveIn}}" data-field="liveIn" bindchange="switchField" /></view>
  </view>

  <view class="form-section" wx:else>
    <text class="section-title">保姆需求</text>
    <view class="field"><text>服务方式</text><picker range="{{modeOptions}}" bindchange="modeChange"><view class="picker-value">{{form.serviceMode}}</view></picker></view>
    <view class="field"><text>家庭人数</text><input type="number" maxlength="2" value="{{form.familySize}}" data-field="familySize" bindinput="inputField" /></view>
    <view class="field"><text>家中有宠物</text><switch color="#175cd3" checked="{{form.pets}}" data-field="pets" bindchange="switchField" /></view>
    <view class="field"><text>服务时段</text><picker range="{{scheduleOptions}}" bindchange="scheduleChange"><view class="picker-value">{{form.schedule}}</view></picker></view>
    <view class="field vertical"><text>服务项目（可多选）</text><checkbox-group bindchange="tasksChange"><label class="service-task" wx:for="{{taskOptions}}" wx:key="*this"><checkbox value="{{item}}" color="#087443" />{{item}}</label></checkbox-group></view>
  </view>

  <button class="submit-button" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">提交预约申请</button>
</view>

.demand-page { min-height: 100vh; padding: 24rpx 28rpx 60rpx; color: #101828; background: #f7f8fa; }
.demand-head { padding: 26rpx; color: #fff; border-radius: 14rpx; background: #b4235f; }
.demand-head.nanny { background: #175cd3; }
.demand-title { display: block; font-size: 32rpx; font-weight: 800; }
.demand-desc { display: block; margin-top: 10rpx; color: rgba(255,255,255,.82); font-size: 22rpx; line-height: 1.45; }
.form-section { margin-top: 18rpx; padding: 24rpx; background: #fff; border: 1rpx solid #e4e7ec; border-radius: 14rpx; }
.section-title { display: block; margin-bottom: 10rpx; font-size: 27rpx; font-weight: 800; }
.field { min-width: 0; min-height: 86rpx; display: flex; align-items: center; gap: 18rpx; border-bottom: 1rpx solid #eaecf0; }
.field:last-child { border-bottom: 0; }
.field > text { width: 150rpx; flex-shrink: 0; color: #344054; font-size: 23rpx; }
.field input,.field picker { min-width: 0; flex: 1; font-size: 24rpx; text-align: right; }
.field.vertical { display: block; padding: 20rpx 0; }
.field.vertical > text { display: block; width: auto; margin-bottom: 12rpx; }
.field textarea,.description { width: 100%; min-height: 130rpx; padding: 16rpx; color: #101828; background: #f8fafc; border-radius: 10rpx; font-size: 23rpx; line-height: 1.55; }
.picker-value { color: #475467; font-size: 24rpx; text-align: right; }
.budget-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.budget-row .field { display: block; padding: 18rpx 0; }
.budget-row .field > text { display: block; width: auto; margin-bottom: 10rpx; }
.budget-row .field input { width: 100%; text-align: left; }
.description { margin-top: 14rpx; }
.submit-button { width: 100%; height: 88rpx; margin-top: 22rpx; color: #fff; background: #087443; border-radius: 14rpx; font-size: 28rpx; }

.reservation-notice {margin:20rpx 0;padding:24rpx;background:#edf7f1;color:#245b44;font-size:25rpx;line-height:1.7;border-radius:12rpx;}
.service-task {display:flex;align-items:center;padding:14rpx 0;gap:12rpx;}

<view class="safe-page proxy-page">
  <view class="proxy-header">
    <view class="app-brand-row">
      <view class="app-logo-mark">
        <image class="app-logo-image" src="/assets/logo-mark.png" mode="aspectFit" />
      </view>
      <view class="app-brand-copy">
        <text class="proxy-title">代客下单</text>
        <text class="proxy-subtitle">填写客户信息，订单进入门店受理</text>
      </view>
    </view>
    <view class="proxy-status">
      <image class="proxy-status-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
      <text>{{mediaStats.title}}</text>
    </view>
  </view>

  <view class="proxy-card">
    <view class="proxy-section-head">
      <image class="section-icon" src="/assets/ui/profile-user.png" mode="aspectFit" />
      <text class="section-title">客户</text>
    </view>

    <view class="field-row">
      <view class="field-item">
        <view class="label-row">
          <image class="label-icon" src="/assets/ui/profile-user.png" mode="aspectFit" />
          <text class="label">姓名</text>
        </view>
        <input
          class="input"
          placeholder-class="field-placeholder"
          placeholder="可不填"
          value="{{customerName}}"
          data-field="name"
          bindfocus="onFieldFocus"
          bindblur="onFieldBlur"
          bindinput="onNameInput"
        />
      </view>

      <view class="field-item {{validationErrors.customerPhone ? 'error' : ''}}">
        <view class="label-row">
          <image class="label-icon" src="/assets/ui/phone.png" mode="aspectFit" />
          <text class="label">手机号</text>
        </view>
        <input
          class="input"
          type="number"
          maxlength="11"
          placeholder-class="field-placeholder"
          placeholder="客户手机号"
          value="{{customerPhone}}"
          data-field="customerPhone"
          bindfocus="onFieldFocus"
          bindblur="onFieldBlur"
          bindinput="onCustomerPhoneInput"
        />
        <text wx:if="{{validationErrors.customerPhone}}" class="field-tip error">{{validationErrors.customerPhone}}</text>
      </view>
    </view>

    <view class="field-item">
      <view class="label-row">
        <image class="label-icon" src="/assets/ui/phone.png" mode="aspectFit" />
        <text class="label">联系电话</text>
        <text class="label-note">默认同客户手机号</text>
      </view>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder-class="field-placeholder"
        placeholder="上门联系号码"
        value="{{contactPhone}}"
        data-field="contactPhone"
        bindfocus="onFieldFocus"
        bindblur="onFieldBlur"
        bindinput="onContactPhoneInput"
      />
    </view>
  </view>

  <view class="proxy-card">
    <view class="proxy-section-head">
      <image class="section-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
      <text class="section-title">需求</text>
    </view>

    <view class="field-row">
      <view class="field-item">
        <view class="label-row">
          <image class="label-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
          <text class="label">类型</text>
        </view>
        <picker mode="selector" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="onCategoryChange">
          <view class="picker-value tap-feedback" hover-class="tap-feedback-active" hover-start-time="20" hover-stay-time="80">
            <text class="picker-text">{{categoryName}}</text>
            <image class="picker-icon" src="/assets/ui/chevron-right.png" mode="aspectFit" />
          </view>
        </picker>
      </view>

      <view class="field-item"><address-fields value="{{addressFieldsValue}}" bindchange="onAddressFieldsChange" /><text wx:if="{{validationErrors.address}}" class="field-tip error">{{validationErrors.address}}</text></view>
    </view>

    <view class="field-item {{validationErrors.description ? 'error' : ''}}">
      <view class="label-row">
        <image class="label-icon" src="/assets/ui/image.png" mode="aspectFit" />
        <text class="label">问题描述</text>
        <text class="label-note">{{mediaStats.desc}}</text>
      </view>
      <textarea
        class="textarea"
        placeholder-class="field-placeholder"
        placeholder="客户反馈的问题、现场情况、预约时间"
        maxlength="500"
        value="{{description}}"
        data-field="description"
        bindfocus="onFieldFocus"
        bindblur="onFieldBlur"
        bindinput="onDescInput"
      />
      <view class="desc-tools-row">
        <text class="field-tip">{{description.length}}/500</text>
        <text wx:if="{{validationErrors.description}}" class="field-tip error">{{validationErrors.description}}</text>
      </view>

      <view class="media-actions">
        <button wx:if="{{!recording}}" class="media-btn audio" bindtap="startVoice" hover-class="button-hover">
          <image class="media-btn-icon" src="/assets/ui/mic.png" mode="aspectFit" />
          <text>语音</text>
        </button>
        <button wx:if="{{recording}}" class="media-btn recording" bindtap="stopVoice" hover-class="button-hover">
          <image class="media-btn-icon" src="/assets/ui/stop-record.png" mode="aspectFit" />
          <text>停止 {{recordSeconds}}s</text>
        </button>
        <button class="media-btn image" bindtap="chooseImage" hover-class="button-hover">
          <image class="media-btn-icon" src="/assets/ui/image.png" mode="aspectFit" />
          <text>照片</text>
        </button>
        <button class="media-btn video" bindtap="chooseVideo" hover-class="button-hover">
          <image class="media-btn-icon" src="/assets/ui/video.png" mode="aspectFit" />
          <text>视频</text>
        </button>
      </view>

      <view wx:if="{{mediaList.length > 0}}" class="media-count-row">
        <text wx:if="{{mediaStats.audioCount}}">语音 {{mediaStats.audioCount}}</text>
        <text wx:if="{{mediaStats.imageCount}}">照片 {{mediaStats.imageCount}}</text>
        <text wx:if="{{mediaStats.videoCount}}">视频 {{mediaStats.videoCount}}</text>
      </view>

      <view wx:if="{{mediaList.length > 0}}" class="media-list">
        <view class="media-item" wx:for="{{mediaList}}" wx:key="key">
          <view class="media-icon-wrap">
            <image class="media-icon" src="{{item.icon}}" mode="aspectFit" />
          </view>
          <view class="media-info tap-feedback" data-index="{{index}}" bindtap="previewMedia" hover-class="tap-feedback-active" hover-start-time="20" hover-stay-time="80">
            <text class="media-type">{{item.typeText}}</text>
            <text class="media-name">{{item.name}}</text>
            <text wx:if="{{item.durationText}}" class="media-duration">{{item.durationText}}</text>
          </view>
          <button class="media-remove" data-index="{{index}}" bindtap="removeMedia" hover-class="button-hover">
            <image class="mini-action-icon" src="/assets/ui/trash.png" mode="aspectFit" />
          </button>
        </view>
      </view>
    </view>
  </view>

  <view class="proxy-card">
    <view class="proxy-section-head">
      <image class="section-icon" src="/assets/ui/address.png" mode="aspectFit" />
      <text class="section-title">受理</text>
      <text wx:if="{{optionsLoading}}" class="section-note">加载中</text>
      <text wx:if="{{optionsFailed}}" class="section-note warning">自动匹配</text>
    </view>

    <view class="address-routing">
      <view><text class="routing-label">服务区域</text><text class="routing-value">{{currentRegionName}}</text></view>
      <view><text class="routing-label">接单门店</text><text class="routing-value">{{currentStoreName}}</text></view>
    </view>
    <text wx:if="{{optionsFailed}}" class="field-tip warning">暂无已开通标准地址，请先由平台补充地址库</text>
  </view>

  <view class="proxy-submit-bar">
    <view class="submit-copy">
      <text class="submit-label">{{categoryName}}</text>
      <text class="submit-desc">{{currentStoreName}}</text>
    </view>
    <button class="submit-btn" bindtap="submitOrder" loading="{{submitting}}" disabled="{{submitting}}" hover-class="button-hover">
      <view class="mini-action-content">
        <image class="submit-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
        <text>提交订单</text>
      </view>
    </button>
  </view>

  <view wx:if="{{showPrivacyModal}}" class="privacy-mask">
    <view class="privacy-dialog">
      <text class="privacy-title">素材授权</text>
      <text class="privacy-desc">
        语音、照片和视频仅用于维修判断。请阅读并同意
        <text class="privacy-link" bindtap="openPrivacyContract">《{{privacyContractName}}》</text>
      </text>
      <view class="privacy-actions">
        <button class="privacy-secondary" bindtap="handleRejectPrivacy" hover-class="button-hover">
          <view class="mini-action-content">
            <image class="mini-action-icon" src="/assets/ui/logout.png" mode="aspectFit" />
            <text>取消</text>
          </view>
        </button>
        <button
          id="agree-btn"
          class="privacy-primary"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="handleAgreePrivacyAuthorization"
          loading="{{privacyLoading}}"
          disabled="{{privacyLoading}}"
          hover-class="button-hover"
        >
          <view class="mini-action-content">
            <image class="mini-action-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
            <text>同意并继续</text>
          </view>
        </button>
      </view>
    </view>
  </view>
</view>

<role-tabbar />

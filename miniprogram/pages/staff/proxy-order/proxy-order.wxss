.proxy-page {
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
  background: #f6f7f9;
}

.proxy-header,
.proxy-card {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  box-shadow: none;
}

.proxy-header {
  padding: 22rpx;
}

.proxy-title {
  display: block;
  color: #101828;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.18;
  word-break: break-all;
}

.proxy-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.proxy-status {
  min-height: 54rpx;
  margin-top: 18rpx;
  padding: 0 16rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  color: #087443;
  background: #f3fbf7;
  border: 1rpx solid #bfe9d1;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}

.proxy-status text {
  min-width: 0;
  overflow: hidden;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.proxy-status-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.proxy-card {
  margin-top: 14rpx;
  padding: 20rpx;
}

.proxy-section-head {
  min-height: 40rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.section-icon,
.label-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.section-title {
  min-width: 0;
  flex: 1;
  color: #101828;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.25;
}

.section-note {
  flex-shrink: 0;
  color: #667085;
  font-size: 22rpx;
  font-weight: 800;
}

.section-note.warning {
  color: #b54708;
}

.field-row {
  display: flex;
  gap: 14rpx;
}

.field-item {
  min-width: 0;
  flex: 1;
  margin-bottom: 18rpx;
}

.field-item:last-child {
  margin-bottom: 0;
}

.label-row {
  min-height: 34rpx;
  margin-bottom: 9rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.label {
  min-width: 0;
  color: #344054;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.3;
  word-break: break-all;
}

.label-note {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #98a2b3;
  font-size: 21rpx;
  line-height: 1.3;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.input,
.picker-value,
.textarea {
  width: 100%;
  min-width: 0;
  color: #101828;
  background: #f8fafc;
  border: 1rpx solid #d0d5dd;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.input,
.picker-value {
  height: 72rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  line-height: 1.25;
}

.textarea {
  height: 156rpx;
  padding: 17rpx 18rpx;
  line-height: 1.5;
  word-break: break-all;
}

.field-placeholder {
  color: #98a2b3;
}

.field-item.error .input,
.field-item.error .textarea {
  border-color: #f04438;
  box-shadow: 0 0 0 4rpx rgba(240, 68, 56, 0.08);
}

.picker-text {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #101828;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-picker-value {
  height: auto;
  min-height: 92rpx;
  padding-top: 14rpx;
  padding-bottom: 14rpx;
}

.address-picker-copy {
  min-width: 0;
  flex: 1;
}

.address-picker-main,
.address-picker-code,
.routing-label,
.routing-value {
  display: block;
}

.address-picker-main {
  color: #101828;
  font-size: 24rpx;
  line-height: 1.45;
}

.address-picker-code {
  margin-top: 6rpx;
  color: #667085;
  font-size: 19rpx;
}

.address-routing {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
}

.routing-label {
  color: #667085;
  font-size: 20rpx;
}

.routing-value {
  margin-top: 5rpx;
  color: #101828;
  font-size: 22rpx;
  line-height: 1.35;
}

.picker-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
  opacity: 0.66;
}

.field-tip {
  display: block;
  margin-top: 8rpx;
  color: #98a2b3;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
}

.field-tip.error {
  color: #b42318;
  font-weight: 800;
}

.desc-tools-row {
  margin-top: 8rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.media-actions {
  margin-top: 14rpx;
  display: flex;
  gap: 10rpx;
}

.media-btn {
  min-width: 0;
  height: 68rpx;
  flex: 1;
  gap: 7rpx;
  color: #087443;
  background: #ffffff;
  border: 1rpx solid #d0d5dd;
  border-radius: 12rpx;
  font-size: 23rpx;
  font-weight: 900;
}

.media-btn.image {
  color: #175cd3;
}

.media-btn.video {
  color: #b54708;
}

.media-btn.recording {
  color: #ffffff;
  background: #dc6803;
  border-color: #dc6803;
}

.media-btn text {
  min-width: 0;
  overflow: hidden;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.media-btn-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.media-count-row {
  margin-top: 10rpx;
  display: flex;
  gap: 8rpx;
}

.media-count-row text {
  min-width: 0;
  height: 42rpx;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #667085;
  background: #f8fafc;
  border: 1rpx solid #edf1f5;
  border-radius: 11rpx;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.media-list {
  margin-top: 14rpx;
}

.media-item {
  min-width: 0;
  margin-bottom: 10rpx;
  padding: 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f8fafc;
  border: 1rpx solid #edf1f5;
  border-radius: 14rpx;
}

.media-item:last-child {
  margin-bottom: 0;
}

.media-icon-wrap {
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.media-icon,
.media-remove .mini-action-icon {
  width: 28rpx;
  height: 28rpx;
}

.media-info {
  min-width: 0;
  flex: 1;
}

.media-type {
  display: inline-flex;
  max-width: 100%;
  margin-right: 8rpx;
  padding: 5rpx 10rpx;
  overflow: hidden;
  color: #175cd3;
  background: #eff4ff;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.media-name {
  display: inline;
  color: #344054;
  font-size: 23rpx;
  line-height: 1.4;
  word-break: break-all;
}

.media-duration {
  display: block;
  margin-top: 4rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.3;
}

.media-remove {
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  color: #b42318;
  background: #fef3f2;
  border: 1rpx solid #fecdca;
  border-radius: 12rpx;
}

.proxy-submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  z-index: 55;
  padding: 12rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #e5e7eb;
}

.submit-copy {
  min-width: 0;
  flex: 1;
}

.submit-label {
  display: block;
  overflow: hidden;
  color: #101828;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submit-desc {
  display: block;
  margin-top: 5rpx;
  overflow: hidden;
  color: #667085;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submit-btn {
  width: 220rpx;
  height: 76rpx;
  flex-shrink: 0;
  padding: 0 18rpx;
  color: #ffffff;
  background: #087443;
  border-radius: 14rpx;
  font-size: 27rpx;
  font-weight: 900;
}

.submit-btn text {
  min-width: 0;
  overflow: hidden;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submit-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.privacy-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.48);
}

.privacy-dialog {
  width: 100%;
  max-height: calc(100vh - 120rpx);
  overflow-y: auto;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 14rpx 14rpx 0 0;
}

.privacy-title {
  display: block;
  color: #101828;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.privacy-desc {
  display: block;
  margin-top: 14rpx;
  color: #475467;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.privacy-link {
  color: #175cd3;
  font-weight: 900;
}

.privacy-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 12rpx;
}

.privacy-secondary,
.privacy-primary {
  min-width: 0;
  height: 80rpx;
  flex: 1;
  border-radius: 14rpx;
  font-size: 27rpx;
  font-weight: 900;
}

.privacy-secondary {
  color: #344054;
  background: #f2f4f7;
}

.privacy-primary {
  color: #ffffff;
  background: #087443;
}

@media (max-width: 360px) {
  .field-row,
  .media-actions {
    flex-wrap: wrap;
  }

  .field-item,
  .media-btn {
    width: 100%;
    flex-basis: 100%;
  }
}

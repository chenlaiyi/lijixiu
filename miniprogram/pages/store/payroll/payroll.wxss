.payroll-page { min-height: 100vh; padding: 28rpx; color: #101828; background: #f7f8fa; }.payroll-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }.page-title { display: block; font-size: 32rpx; font-weight: 800; }.page-desc { display: block; margin-top: 8rpx; max-width: 440rpx; color: #667085; font-size: 21rpx; line-height: 1.45; }.month-picker { min-width: 150rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; color: #175cd3; background: #eff4ff; border-radius: 10rpx; font-size: 22rpx; }.employee-list,.period-list { display: flex; flex-direction: column; gap: 12rpx; margin-top: 24rpx; }.employee-row,.period-row { display: flex; align-items: center; gap: 18rpx; padding: 22rpx; background: #fff; border: 1rpx solid #e4e7ec; border-radius: 12rpx; }.employee-copy { min-width: 0; flex: 1; }.employee-name,.period-month { display: block; font-size: 25rpx; font-weight: 800; }.employee-work,.period-status { display: block; margin-top: 7rpx; color: #667085; font-size: 20rpx; }.salary-field { width: 190rpx; height: 64rpx; display: flex; align-items: center; gap: 7rpx; padding: 0 14rpx; background: #f8fafc; border: 1rpx solid #d0d5dd; border-radius: 10rpx; }.salary-field input { min-width: 0; flex: 1; font-size: 24rpx; }.generate-button { width: 100%; height: 82rpx; margin-top: 18rpx; color: #fff; background: #087443; }.section-head { margin-top: 34rpx; font-size: 28rpx; font-weight: 800; }.period-row > view { min-width: 0; flex: 1; }.period-row button { width: 150rpx; height: 60rpx; color: #fff; background: #175cd3; font-size: 22rpx; }.paid-mark { color: #067647; font-size: 22rpx; font-weight: 800; }
.period-pill { display: inline-block; margin-top: 8rpx; padding: 4rpx 12rpx; font-size: 20rpx; font-weight: 700; border-radius: 8rpx; }.empty-state { min-height: 360rpx; display: flex; align-items: center; justify-content: center; color: #667085; }.empty-state.small { min-height: 160rpx; background: #fff; border-radius: 12rpx; flex-direction: column; gap: 10rpx; }
.empty-state.column { flex-direction: column; gap: 10rpx; }
.empty-state-title { display: block; color: #344054; font-size: 26rpx; font-weight: 700; }
.empty-state-desc { display: block; color: #667085; font-size: 21rpx; text-align: center; max-width: 540rpx; word-break: break-all; }
.empty-state-retry { min-width: 180rpx; height: 64rpx; line-height: 64rpx; color: #fff; background: #087443; border-radius: 12rpx; font-size: 24rpx; margin-top: 10rpx; }

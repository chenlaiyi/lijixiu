<view class="safe-page role-page second-dashboard-page">
  <view class="role-hero">
    <view class="role-hero-head">
      <view class="app-brand-row">
        <view class="app-logo-mark">
          <image class="app-logo-image" src="/assets/logo-mark.png" mode="aspectFit" />
        </view>
        <view class="app-brand-copy">
          <text class="role-title">兜底工单</text>
          <text class="role-subtitle">待接和服务中</text>
        </view>
      </view>
      <button class="role-ghost-btn" hover-class="button-hover" bindtap="goRepairer">
        <view class="mini-action-content">
          <image class="mini-action-icon" src="/assets/ui/repairer.png" mode="aspectFit" />
          <text>工单</text>
        </view>
      </button>
    </view>
  </view>

  <view class="role-focus-strip">
    <view class="role-focus-main">
      <image class="role-focus-icon" src="/assets/ui/repairer.png" mode="aspectFit" />
      <view class="role-focus-copy">
        <text class="role-focus-label">{{focusHint.title}}</text>
        <text class="role-focus-value">{{focusHint.desc}}</text>
      </view>
    </view>
    <text class="role-focus-chip">兜底 {{stats.fallback}}</text>
  </view>

  <view class="role-stat-grid second-action-grid">
    <view class="role-stat-card role-stat-card-rich stat-fallback">
      <view class="role-stat-head">
        <image class="role-stat-icon" src="/assets/ui/repairer.png" mode="aspectFit" />
        <text class="role-stat-label">兜底</text>
      </view>
      <text class="role-stat-num">{{stats.fallback}}</text>
    </view>
    <view class="role-stat-card role-stat-card-rich stat-assigned">
      <view class="role-stat-head">
        <image class="role-stat-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
        <text class="role-stat-label">待接</text>
      </view>
      <text class="role-stat-num">{{stats.assigned}}</text>
    </view>
    <view class="role-stat-card role-stat-card-rich stat-servicing">
      <view class="role-stat-head">
        <image class="role-stat-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
        <text class="role-stat-label">服务中</text>
      </view>
      <text class="role-stat-num">{{stats.servicing}}</text>
    </view>
    <view class="role-stat-card role-stat-card-rich stat-bill">
      <view class="role-stat-head">
        <image class="role-stat-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
        <text class="role-stat-label">服务单</text>
      </view>
      <text class="role-stat-num">{{stats.bills}}</text>
    </view>
  </view>

  <view wx:if="{{loadFailed}}" class="role-empty">
    <view class="role-empty-inner">
      <image class="role-empty-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
      <text class="role-empty-title">加载失败</text>
      <text class="role-empty-desc">点击重试</text>
      <button class="role-empty-action" hover-class="button-hover" bindtap="loadData">
        <view class="mini-action-content">
          <image class="mini-action-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
          <text>重试</text>
        </view>
      </button>
    </view>
  </view>

  <view wx:if="{{!loadFailed}}" class="role-section">
    <view class="role-section-head">
      <view class="role-section-copy">
        <view class="role-section-title-row">
          <image class="role-section-icon" src="/assets/ui/repairer.png" mode="aspectFit" />
          <text class="role-section-title">工单</text>
        </view>
        <text class="role-section-subtitle">先看素材再接单</text>
      </view>
    </view>
    <view wx:if="{{loading}}" class="role-empty">
      <view class="role-empty-inner">
        <image class="role-empty-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
        <text class="role-empty-title">加载中…</text>
      </view>
    </view>
    <view wx:if="{{orders.length === 0 && !loading}}" class="role-empty">
      <view class="role-empty-inner">
        <image class="role-empty-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
        <text class="role-empty-title">暂无订单</text>
        <text class="role-empty-desc">派单后显示</text>
      </view>
    </view>
    <view class="role-card" wx:for="{{orders}}" wx:key="id">
      <view class="role-card-head">
        <image class="role-card-icon" src="{{item.categoryIcon}}" mode="aspectFit" />
        <view class="role-card-main">
          <view class="role-line">
            <text class="role-strong">#{{item.id}} {{item.categoryText}}</text>
            <text class="role-pill {{item.statusTone}}">{{item.statusText}}</text>
          </view>
          <text class="role-desc">{{item.description}}</text>
          <view wx:if="{{item.mediaSummary}}" class="role-meta-row">
            <image class="role-meta-icon" src="/assets/ui/image.png" mode="aspectFit" />
            <text class="role-meta-text">素材 {{item.mediaSummary}}</text>
          </view>
          <view wx:if="{{item.address}}" class="role-meta-row">
            <image class="role-meta-icon" src="/assets/ui/address.png" mode="aspectFit" />
            <text class="role-meta-text">{{item.address}}</text>
          </view>
          <view class="role-card-next">
            <text class="role-card-next-title">{{item.nextStep.title}}</text>
            <text class="role-card-next-desc">{{item.nextStep.desc}}</text>
          </view>
          <text class="role-money">¥{{item.priceText}}</text>
        </view>
      </view>
      <view class="role-actions">
        <button wx:if="{{item.canAccept}}" class="role-primary-btn" hover-class="button-hover" data-id="{{item.id}}" bindtap="acceptOrder">
          <view class="role-button-content">
            <image class="role-action-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
            <text>接单</text>
          </view>
        </button>
        <button wx:if="{{item.canFallback}}" class="role-secondary-btn" hover-class="button-hover" data-id="{{item.id}}" bindtap="fallbackOrder">
          <view class="role-button-content">
            <image class="role-action-icon" src="/assets/ui/repairer.png" mode="aspectFit" />
            <text>兜底接单</text>
          </view>
        </button>
        <button class="role-secondary-btn" hover-class="button-hover" data-id="{{item.id}}" bindtap="openDetail">
          <view class="role-button-content">
            <image class="role-action-icon" src="/assets/ui/chevron-right.png" mode="aspectFit" />
            <text>看详情</text>
          </view>
        </button>
      </view>
    </view>
  </view>
</view>

<role-tabbar />

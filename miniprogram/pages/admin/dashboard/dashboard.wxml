<view class="safe-page admin-page">
  <view class="admin-hero">
    <view class="app-brand-row">
      <view class="app-logo-mark">
        <image class="app-logo-image" src="/assets/logo-mark.png" mode="aspectFit" />
      </view>
      <view class="app-brand-copy">
        <text class="hero-title">平台工作台</text>
        <text class="hero-desc">工单、提现、风险</text>
      </view>
    </view>
    <button class="client-btn" hover-class="button-hover" bindtap="goCustomer">
      <view class="mini-action-content">
        <image class="mini-action-icon" src="/assets/ui/receipt.png" mode="aspectFit" /><text>代下单</text>
      </view>
    </button>
  </view>

  <view class="admin-overview">
    <view class="overview-main">
      <image class="overview-icon" src="/assets/ui/admin.png" mode="aspectFit" />
      <view class="overview-copy">
        <text class="overview-label">{{opsView.hintTitle}}</text>
        <text class="overview-value">{{opsView.hintDesc}}</text>
      </view>
    </view>
    <view class="overview-tags">
      <text class="overview-tag tone-warning">待派 {{opsView.needDispatch}}</text>
      <text class="overview-tag tone-action">服务单 {{opsView.needBill}}</text>
      <text class="overview-tag tone-success">计薪 {{opsView.needReview}}</text>
      <text class="overview-tag tone-waiting">提现 {{opsView.pendingWithdrawals}}</text>
      <text class="overview-tag tone-danger">告警 {{opsView.alertCount}}</text>
    </view>
  </view>

  <scroll-view class="admin-quick-nav" scroll-x enhanced show-scrollbar="{{false}}">
    <button class="quick-nav-btn" hover-class="button-hover" data-target="#orders-section" bindtap="scrollToSection">
      <view class="mini-action-content">
        <image class="mini-action-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
        <text>工单 {{orders.length}}</text>
      </view>
    </button>
    <button class="quick-nav-btn" hover-class="button-hover" data-target="#withdrawals-section" bindtap="scrollToSection">
      <view class="mini-action-content">
        <image class="mini-action-icon" src="/assets/ui/wallet.png" mode="aspectFit" />
        <text>提现 {{opsView.pendingWithdrawals}}</text>
      </view>
    </button>
    <button class="quick-nav-btn" hover-class="button-hover" data-target="#stores-section" bindtap="scrollToSection">
      <view class="mini-action-content">
        <image class="mini-action-icon" src="/assets/ui/address.png" mode="aspectFit" />
        <text>门店 {{stores.length}}</text>
      </view>
    </button>
    <button class="quick-nav-btn" hover-class="button-hover" data-target="#alerts-section" bindtap="scrollToSection">
      <view class="mini-action-content">
        <image class="mini-action-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
        <text>告警 {{alerts.length}}</text>
      </view>
    </button>
  </scroll-view>

  <view class="action-row">
    <button hover-class="button-hover" bindtap="runReconcile">
      <view class="action-content">
        <image class="action-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
        <text>对账</text>
      </view>
    </button>
    <button class="danger-action" hover-class="button-hover" bindtap="logout">
      <view class="action-content">
        <image class="action-icon" src="/assets/ui/logout.png" mode="aspectFit" />
        <text>退出</text>
      </view>
    </button>
  </view>

  <view class="metric-grid">
    <view class="metric-card metric-total">
      <view class="metric-head">
        <image class="metric-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
        <text class="metric-label">订单</text>
      </view>
      <text class="metric-num">{{metricsView.ordersTotal}}</text>
    </view>
    <view class="metric-card metric-done">
      <view class="metric-head">
        <image class="metric-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
        <text class="metric-label">已完成</text>
      </view>
      <text class="metric-num">{{metricsView.ordersCompleted}}</text>
    </view>
    <view class="metric-card metric-users">
      <view class="metric-head">
        <image class="metric-icon" src="/assets/ui/profile-user.png" mode="aspectFit" />
        <text class="metric-label">用户</text>
      </view>
      <text class="metric-num">{{users.length}}</text>
    </view>
    <view class="metric-card metric-repairers">
      <view class="metric-head">
        <image class="metric-icon" src="/assets/ui/repairer.png" mode="aspectFit" />
        <text class="metric-label">师傅</text>
      </view>
      <text class="metric-num">{{repairers.length}}</text>
    </view>
  </view>

  <view wx:if="{{loadFailed}}" class="role-empty">
    <view class="role-empty-inner">
      <image class="role-empty-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
      <text class="role-empty-title">加载失败</text>
      <text class="role-empty-desc">点击重试</text>
      <button class="role-empty-action" hover-class="button-hover" bindtap="loadData">
        <view class="mini-action-content">
          <image class="mini-action-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
          <text>重试</text>
        </view>
      </button>
    </view>
  </view>

  <view wx:elif="{{loadWarningText}}" class="role-inline-alert">
    <image class="role-inline-alert-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
    <text class="role-inline-alert-text">{{loadWarningText}}</text>
  </view>

  <block wx:if="{{!loadFailed}}">
  <view id="orders-section" class="section">
    <view class="section-head">
      <image class="section-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
      <view class="section-copy">
        <text class="section-title">工单</text>
        <text class="section-subtitle">受理、派单、审核</text>
      </view>
    </view>
    <view wx:if="{{loading}}" class="empty">
      <image class="empty-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
      <text class="empty-title">加载中…</text>
    </view>
    <view wx:if="{{!loading && orders.length === 0}}" class="empty">
      <image class="empty-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
      <text class="empty-title">暂无订单</text>
      <text class="empty-desc">下单后显示</text>
    </view>
    <view class="data-card" wx:for="{{orders}}" wx:key="id">
      <view class="admin-card-head">
        <image class="admin-card-icon" src="{{item.categoryIcon}}" mode="aspectFit" />
        <view class="admin-card-main">
          <view class="card-line">
            <text class="strong">#{{item.id}} {{item.categoryText}}</text>
            <text class="pill {{item.statusTone}}">{{item.statusText}}</text>
          </view>
          <text class="desc">{{item.description}}</text>
          <view wx:if="{{item.address}}" class="admin-meta-row">
            <image class="admin-meta-icon" src="/assets/ui/address.png" mode="aspectFit" />
            <text class="admin-meta-text">{{item.address}}</text>
          </view>
          <view wx:if="{{item.mediaSummary}}" class="admin-meta-row">
            <image class="admin-meta-icon" src="/assets/ui/image.png" mode="aspectFit" />
            <text class="admin-meta-text">素材 {{item.mediaSummary}}</text>
          </view>
          <view class="role-card-next">
            <text class="role-card-next-title">{{item.nextStep.title}}</text>
            <text class="role-card-next-desc">{{item.nextStep.desc}}</text>
          </view>
          <text class="money">¥{{item.priceText}}</text>
        </view>
      </view>
      <view wx:if="{{item.hasBill}}" class="bill-preview order-bill-preview">
        <view class="bill-preview-head">
          <view class="bill-preview-title">
            <image class="bill-preview-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
            <text>服务单明细</text>
          </view>
          <text>合计 ¥{{item.billAmountText}} · 保修 {{item.billWarrantyText}}</text>
        </view>
        <view class="bill-preview-item" wx:for="{{item.billItems}}" wx:key="name">
          <view class="bill-preview-copy">
            <text class="bill-preview-name">{{item.name}}</text>
            <text class="bill-preview-meta">数量 {{item.qtyText}} · 单价 ¥{{item.priceText}}</text>
          </view>
          <text class="bill-preview-amount">¥{{item.amountText}}</text>
        </view>
      </view>
      <view class="order-actions" wx:if="{{item.hasMedia}}">
        <button class="self-btn" hover-class="button-hover" data-id="{{item.id}}" bindtap="openOrderDetail">
          <view class="action-content">
            <image class="action-icon" src="/assets/ui/image.png" mode="aspectFit" />
            <text>看素材</text>
          </view>
        </button>
      </view>
      <view class="order-actions" wx:if="{{item.hasOrderActions}}">
        <button wx:if="{{item.canStoreAccept}}" class="accept-btn" hover-class="button-hover" data-id="{{item.id}}" bindtap="storeAccept">
          <view class="action-content">
            <image class="action-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
            <text>受理工单</text>
          </view>
        </button>
        <button wx:if="{{item.canSelfServe}}" class="self-btn" hover-class="button-hover" data-id="{{item.id}}" bindtap="selfServe">
          <view class="action-content">
            <image class="action-icon" src="/assets/ui/repairer.png" mode="aspectFit" />
            <text>我来服务</text>
          </view>
        </button>
        <button wx:if="{{item.canOpenService}}" class="self-btn" hover-class="button-hover" data-id="{{item.id}}" bindtap="goServiceDetail">
          <view class="action-content">
            <image class="action-icon" src="/assets/ui/chevron-right.png" mode="aspectFit" />
            <text>服务单</text>
          </view>
        </button>
        <view wx:if="{{item.canAssign}}" class="assign-box">
          <picker mode="selector" range="{{repairerOptions}}" range-key="label" value="{{item.assignIndex}}" data-id="{{item.id}}" bindchange="onRepairerChange">
            <view class="picker-line">
              <text class="picker-text">{{item.selectedRepairerText}}</text>
              <image class="picker-icon" src="/assets/ui/chevron-right.png" mode="aspectFit" />
            </view>
          </picker>
          <button class="assign-btn" hover-class="button-hover" data-id="{{item.id}}" bindtap="assignRepairer">
            <view class="action-content">
              <image class="action-icon" src="/assets/ui/repairer.png" mode="aspectFit" />
              <text>指派师傅</text>
            </view>
          </button>
        </view>
        <button wx:if="{{item.canConfirmBill}}" class="confirm-btn" hover-class="button-hover" data-id="{{item.id}}" bindtap="confirmServiceBill">
          <view class="action-content">
            <image class="action-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
            <text>确认服务单</text>
          </view>
        </button>
        <view wx:if="{{item.canStoreReview}}" class="wage-box">
          <view class="wage-mode-row">
            <text class="wage-label">计薪方式</text>
            <picker mode="selector" range="{{wageModes}}" range-key="label" value="{{item.wageModeIndex}}" data-id="{{item.id}}" bindchange="onWageModeChange">
              <view class="wage-mode-picker">
                <text class="picker-text">{{item.wageModeText}}</text>
                <image class="picker-icon" src="/assets/ui/chevron-right.png" mode="aspectFit" />
              </view>
            </picker>
          </view>
          <view wx:if="{{item.wageMode !== 'monthly'}}" class="wage-rate-row">
            <button class="rate-btn" hover-class="button-hover" data-id="{{item.id}}" data-rate="0.5" bindtap="applyWageRate">
              <view class="rate-content">
                <image class="rate-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
                <text>50%</text>
              </view>
            </button>
            <button class="rate-btn" hover-class="button-hover" data-id="{{item.id}}" data-rate="0.6" bindtap="applyWageRate">
              <view class="rate-content">
                <image class="rate-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
                <text>60%</text>
              </view>
            </button>
            <button class="rate-btn" hover-class="button-hover" data-id="{{item.id}}" data-rate="0.7" bindtap="applyWageRate">
              <view class="rate-content">
                <image class="rate-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
                <text>70%</text>
              </view>
            </button>
          </view>
          <view wx:if="{{item.wageMode !== 'monthly'}}" class="wage-input-row">
            <text class="wage-label">师傅工资</text>
            <input class="wage-input" type="digit" value="{{item.wageAmount}}" data-id="{{item.id}}" bindinput="onWageInput" />
          </view>
          <text wx:if="{{item.wageMode === 'monthly'}}" class="monthly-note">月薪人员，本单不计提成。</text>
          <button class="review-btn" hover-class="button-hover" data-id="{{item.id}}" bindtap="storeReview">
            <view class="action-content">
              <image class="action-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
              <text>{{item.wageMode === 'monthly' ? '完成审核' : '记录工资'}}</text>
            </view>
          </button>
        </view>
      </view>
    </view>
  </view>

  <view id="withdrawals-section" class="section">
    <view class="section-head">
      <image class="section-icon" src="/assets/ui/wallet.png" mode="aspectFit" />
      <view class="section-copy">
        <text class="section-title">提现</text>
        <text class="section-subtitle">账户提现</text>
      </view>
    </view>
    <view wx:if="{{loading}}" class="empty">
      <image class="empty-icon" src="/assets/ui/wallet.png" mode="aspectFit" />
      <text class="empty-title">加载中…</text>
    </view>
    <view wx:if="{{!loading && withdrawals.length === 0}}" class="empty">
      <image class="empty-icon" src="/assets/ui/wallet.png" mode="aspectFit" />
      <text class="empty-title">暂无提现</text>
      <text class="empty-desc">有提现后显示</text>
    </view>
    <view class="data-card" wx:for="{{withdrawals}}" wx:key="id">
      <view class="admin-card-head">
        <image class="admin-card-icon" src="/assets/ui/wallet.png" mode="aspectFit" />
        <view class="admin-card-main">
          <view class="card-line">
            <text class="strong">用户 #{{item.user_id}}</text>
            <text class="pill {{item.statusTone}}">{{item.status}}</text>
          </view>
          <text class="money">¥{{item.amount}}</text>
        </view>
      </view>
      <button wx:if="{{item.status === 'pending'}}" class="approve-btn" hover-class="button-hover" data-id="{{item.id}}" bindtap="approveWithdraw">
        <view class="action-content">
          <image class="action-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
          <text>通过</text>
        </view>
      </button>
    </view>
  </view>

  <view id="stores-section" class="section">
    <view class="section-head">
      <image class="section-icon" src="/assets/ui/address.png" mode="aspectFit" />
      <view class="section-copy">
        <text class="section-title">门店</text>
        <text class="section-subtitle">门店负责人</text>
      </view>
    </view>
    <view wx:if="{{loading}}" class="empty">
      <image class="empty-icon" src="/assets/ui/address.png" mode="aspectFit" />
      <text class="empty-title">加载中…</text>
    </view>
    <view wx:if="{{!loading && stores.length === 0}}" class="empty">
      <image class="empty-icon" src="/assets/ui/address.png" mode="aspectFit" />
      <text class="empty-title">暂无门店</text>
      <text class="empty-desc">配置后显示</text>
    </view>
    <view class="data-card" wx:for="{{stores}}" wx:key="id">
      <view class="admin-card-head">
        <image class="admin-card-icon" src="/assets/ui/address.png" mode="aspectFit" />
        <view class="admin-card-main">
          <view class="card-line">
            <text class="strong">{{item.name}}</text>
            <text class="pill {{item.statusTone}}">{{item.status}}</text>
          </view>
          <text class="desc">区域 #{{item.region_id}} · 店长 #{{item.manager_id}}</text>
        </view>
      </view>
    </view>
  </view>

  <view id="alerts-section" class="section">
    <view class="section-head">
      <image class="section-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
      <view class="section-copy">
        <text class="section-title">告警</text>
        <text class="section-subtitle">人工关注</text>
      </view>
    </view>
    <view wx:if="{{loading}}" class="empty">
      <image class="empty-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
      <text class="empty-title">加载中…</text>
    </view>
    <view wx:if="{{!loading && alerts.length === 0}}" class="empty">
      <image class="empty-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
      <text class="empty-title">暂无告警</text>
      <text class="empty-desc">当前无风险</text>
    </view>
    <view class="data-card alert" wx:for="{{alerts}}" wx:key="id">
      <view class="admin-card-head">
        <image class="admin-card-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
        <view class="admin-card-main">
          <text class="strong">{{item.message}}</text>
          <text class="desc">{{item.severity}} · {{item.created_at}}</text>
        </view>
      </view>
    </view>
  </view>
  </block>
</view>

<role-tabbar />

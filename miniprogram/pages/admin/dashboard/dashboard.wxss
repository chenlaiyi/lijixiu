.admin-hero {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx;
  color: #101828;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
}

.hero-title {
  display: block;
  min-width: 0;
  color: #101828;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
  word-break: break-all;
}

.hero-desc {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.client-btn {
  min-width: 144rpx;
  max-width: 100%;
  height: 72rpx;
  flex-shrink: 0;
  padding: 0 18rpx;
  color: #175cd3;
  background: #fff;
  border: 1rpx solid #b2ccff;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 20rpx 0 0;
}

.metric-card {
  width: calc((100% - 16rpx) / 2);
  min-width: 0;
  min-height: 112rpx;
  padding: 18rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
}

.metric-total {
  background: #f8fbff;
  border-color: #d7e8ff;
}

.metric-done {
  background: #f6fef9;
  border-color: #d7f3df;
}

.metric-users {
  background: #fffaf0;
  border-color: #fde68a;
}

.metric-repairers {
  background: #f8fafc;
  border-color: #e5e7eb;
}

.metric-head,
.section-head,
.admin-card-head,
.admin-meta-row,
.action-content {
  display: flex;
  align-items: center;
}

.metric-head {
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.metric-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.metric-num {
  display: block;
  min-width: 0;
  max-width: 100%;
  color: #101828;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.12;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.metric-label {
  display: block;
  min-width: 0;
  flex: 1;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.3;
  word-break: break-all;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.admin-overview {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin: 20rpx 0 16rpx;
  padding: 18rpx 16rpx;
  background: #111827;
  border: 1rpx solid #1f2937;
  border-radius: 14rpx;
  box-shadow: none;
}

.admin-page .role-next-card {
  display: none;
}

.overview-main {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.overview-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  padding: 8rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 14rpx;
}

.overview-copy {
  min-width: 0;
  flex: 1;
}

.overview-label {
  display: block;
  color: #c7d2fe;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-all;
}

.overview-value {
  display: block;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.38;
  word-break: break-all;
}

.overview-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.overview-tag {
  max-width: 100%;
  padding: 8rpx 12rpx;
  border: 1rpx solid transparent;
  border-radius: 10rpx;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-all;
}

.admin-quick-nav {
  position: sticky;
  top: 0;
  z-index: 30;
  width: 100%;
  margin: 0 0 16rpx;
  padding: 10rpx 0;
  white-space: nowrap;
  background: #f6f7f9;
}

.quick-nav-btn {
  display: inline-flex;
  width: auto;
  min-width: 152rpx;
  height: 72rpx;
  margin-right: 10rpx;
  padding: 0 16rpx;
  color: #344054;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  font-size: 24rpx;
  vertical-align: top;
}

.action-row button {
  flex: 1;
  min-width: 220rpx;
  height: 76rpx;
  color: #175cd3;
  background: #eff4ff;
  border: 1rpx solid #b2ccff;
  border-radius: 14rpx;
  font-size: 25rpx;
}

.action-row button.danger-action {
  color: #b42318;
  background: #fef3f2;
  border-color: #fecdca;
}

.action-content {
  justify-content: center;
  gap: 10rpx;
  min-width: 0;
}

.action-content text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.section {
  margin-top: 24rpx;
}

.section-anchor {
  width: 1rpx;
  height: 1rpx;
}

.section-head {
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.section-icon {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
}

.section-title {
  display: block;
  min-width: 0;
  color: #101828;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.3;
  word-break: break-all;
}

.section-copy {
  min-width: 0;
}

.section-subtitle {
  display: block;
  margin-top: 4rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.35;
  word-break: break-all;
}

.data-card,
.empty {
  margin-bottom: 16rpx;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
}

.admin-card-head {
  align-items: flex-start;
  gap: 16rpx;
}

.admin-card-icon {
  width: 54rpx;
  height: 54rpx;
  padding: 10rpx;
  flex-shrink: 0;
  background: #f3f6f8;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
}

.admin-card-main {
  min-width: 0;
  flex: 1;
}

.card-line {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.strong {
  min-width: 0;
  flex: 1;
  color: #101828;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.pill {
  flex-shrink: 0;
  max-width: 240rpx;
  padding: 7rpx 13rpx;
  overflow: hidden;
  color: #175cd3;
  background: #eff4ff;
  border: 1rpx solid transparent;
  border-radius: 10rpx;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.desc {
  display: block;
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.admin-meta-row {
  gap: 8rpx;
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
}

.admin-meta-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.admin-meta-text {
  min-width: 0;
  flex: 1;
  word-break: break-all;
}

.money {
  display: block;
  min-width: 0;
  max-width: 100%;
  margin-top: 12rpx;
  color: #087443;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.approve-btn {
  min-width: 148rpx;
  max-width: 100%;
  height: 72rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  color: #fff;
  background: #087443;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.order-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
  min-width: 0;
}

.accept-btn,
.assign-btn,
.self-btn,
.confirm-btn,
.review-btn {
  width: 100%;
  min-width: 0;
  height: 72rpx;
  padding: 0 18rpx;
  color: #fff;
  border-radius: 14rpx;
  font-size: 25rpx;
}

.accept-btn {
  background: #175cd3;
}

.assign-box {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: flex-start;
}

.assign-box picker {
  flex: 1;
  min-width: 240rpx;
}

.picker-line {
  min-width: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 16rpx;
  color: #344054;
  background: #fff;
  border: 1rpx solid #d0d5dd;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.25;
}

.picker-text {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.assign-btn {
  min-width: 144rpx;
  max-width: 100%;
  padding: 0 16rpx;
  flex-shrink: 0;
  background: #087443;
}

.self-btn {
  color: #175cd3;
  background: #eff4ff;
  border: 1rpx solid #b2ccff;
}

.confirm-btn {
  background: #175cd3;
}

.wage-box {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
  padding: 16rpx 0 0;
  background: transparent;
  border-top: 1rpx solid #edf1f5;
  border-radius: 14rpx;
}

.bill-preview {
  min-width: 0;
  padding: 0 0 14rpx;
  background: transparent;
  border: none;
  border-bottom: 1rpx solid #edf1f5;
  border-radius: 0;
}

.order-bill-preview {
  margin-top: 14rpx;
  padding: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.bill-preview-copy {
  min-width: 0;
  flex: 1;
}

.bill-preview-name,
.bill-preview-meta {
  display: block;
}

.bill-preview-meta {
  margin-top: 4rpx;
  color: #667085;
  font-size: 21rpx;
}

.bill-preview-head,
.bill-preview-item,
.wage-mode-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.bill-preview-head {
  color: #101828;
  font-size: 25rpx;
  font-weight: 900;
}

.bill-preview-title {
  min-width: 0;
  flex: 1 1 240rpx;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.bill-preview-title text {
  min-width: 0;
  line-height: 1.35;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.bill-preview-icon {
  width: 30rpx;
  height: 30rpx;
  display: block;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.bill-preview-head > text {
  min-width: 0;
  max-width: 220rpx;
  line-height: 1.35;
  word-break: break-all;
}

.bill-preview-item {
  align-items: flex-start;
  padding-top: 12rpx;
  color: #667085;
  border-top: 1rpx solid #edf1f5;
  font-size: 23rpx;
}

.bill-preview-name {
  min-width: 0;
  flex: 1;
  line-height: 1.45;
  word-break: break-all;
}

.bill-preview-amount {
  flex-shrink: 0;
  max-width: 180rpx;
  color: #087443;
  font-weight: 900;
  line-height: 1.45;
  text-align: right;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.wage-mode-row picker {
  flex: 1;
  min-width: 240rpx;
}

.wage-mode-picker {
  min-width: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  padding: 0 16rpx;
  color: #175cd3;
  background: #fff;
  border: 1rpx solid #d0d5dd;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
}

.wage-rate-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.wage-rate-row .rate-btn {
  flex: 1;
  min-width: 150rpx;
  height: 72rpx;
  color: #175cd3;
  background: #eff4ff;
  border: 1rpx solid #b2ccff;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.rate-content {
  min-width: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.rate-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.rate-content text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wage-input-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 12rpx;
}

.wage-label {
  flex: 0 1 220rpx;
  max-width: 220rpx;
  color: #344054;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
  word-break: break-all;
}

.wage-input {
  flex: 1;
  min-width: 240rpx;
  width: 100%;
  height: 72rpx;
  padding: 0 16rpx;
  color: #101828;
  background: #fff;
  border: 1rpx solid #d0d5dd;
  border-radius: 12rpx;
  font-size: 27rpx;
}

.review-btn {
  background: #b54708;
}

.monthly-note {
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
  word-break: break-all;
}

.alert .pill {
  color: #b42318;
  background: #fef3f2;
}

.empty {
  color: #667085;
  text-align: center;
}

.empty {
  min-height: 168rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
}

.empty-icon {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.66;
}

.empty-title {
  display: block;
  color: #344054;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.empty-desc {
  display: block;
  max-width: 540rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
  word-break: break-all;
}

/* Mobile polish pass for admin operations. */
.admin-page {
  background: #f6f7f9;
}

.admin-hero,
.metric-card,
.section,
.data-card,
.role-empty-inner,
.role-inline-alert {
  background: #fff;
  border-color: #e5e7eb;
  box-shadow: none;
}

.admin-overview {
  background: #111827;
  border-color: #1f2937;
  box-shadow: none;
}

.overview-tag,
.quick-nav-btn,
.role-card-next,
.admin-meta-row,
.picker-line,
.wage-mode-picker,
.wage-input,
.bill-preview {
  background: #f8fafc;
  border-color: #e5e7eb;
}

.action-row button,
.client-btn,
.quick-nav-btn,
.accept-btn,
.self-btn,
.assign-btn,
.confirm-btn,
.review-btn,
.approve-btn,
.role-empty-action {
  box-shadow: none;
}

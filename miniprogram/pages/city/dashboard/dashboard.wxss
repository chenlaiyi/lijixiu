.city-dashboard-page .role-hero {
  background: #fff;
  border-color: #b9d6fe;
}

.city-dashboard-page .role-title {
  color: #123b73;
}

.role-focus-strip {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  min-height: 84rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  box-shadow: none;
}

.role-focus-main {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.role-focus-icon {
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.role-focus-copy {
  min-width: 0;
  flex: 1;
}

.role-focus-label {
  display: block;
  color: #175cd3;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
  word-break: break-all;
}

.role-focus-value {
  display: block;
  margin-top: 4rpx;
  color: #475467;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.38;
  word-break: break-all;
}

.role-focus-chip {
  flex-shrink: 0;
  max-width: 210rpx;
  min-height: 44rpx;
  padding: 0 13rpx;
  color: #175cd3;
  background: #fff;
  border: 1rpx solid #b9d6fe;
  border-radius: 12rpx;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 44rpx;
  text-align: right;
  word-break: break-all;
}

.city-dashboard-page .role-stat-card {
  border-color: #d7e8ff;
}

.city-action-grid .role-stat-card {
  min-height: 100rpx;
  padding: 16rpx;
}

.city-dashboard-page .stat-store {
  background: #f8fbff;
}

.city-dashboard-page .stat-order {
  background: #f7fffb;
}

.city-dashboard-page .stat-active {
  background: #fffaf0;
}

.city-dashboard-page .stat-revenue {
  background: #f8fafc;
}

/* Mobile polish pass for city role. */
.city-dashboard-page {
  background: #f6f7f9;
}

.city-dashboard-page .role-hero,
.city-dashboard-page .role-focus-strip,
.city-dashboard-page .role-stat-card,
.city-dashboard-page .role-card,
.city-dashboard-page .role-empty-inner {
  background: #fff;
  border-color: #e5e7eb;
  box-shadow: none;
}

.city-dashboard-page .role-card-next,
.city-dashboard-page .role-meta-row,
.city-dashboard-page .role-focus-chip {
  background: #f8fafc;
  border-color: #e5e7eb;
}

.city-dashboard-page .role-ghost-btn,
.city-dashboard-page .role-empty-action {
  box-shadow: none;
}

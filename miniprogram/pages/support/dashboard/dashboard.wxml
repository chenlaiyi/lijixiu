<view class="safe-page role-page support-page">
  <view class="role-hero">
    <view class="role-hero-head">
      <view>
        <text class="role-title">服务保障</text>
        <text class="role-subtitle">资料核验、投诉和售后跟进</text>
      </view>
      <button class="role-ghost-btn" bindtap="logout">退出</button>
    </view>
  </view>

  <view class="role-stat-grid">
    <view class="role-stat-card">
      <text class="role-stat-num">{{stats.open}}</text>
      <text class="role-stat-label">待处理工单</text>
    </view>
    <view class="role-stat-card">
      <text class="role-stat-num">{{stats.domestic}}</text>
      <text class="role-stat-label">家政需求</text>
    </view>
    <view class="role-stat-card">
      <text class="role-stat-num">{{stats.complaint}}</text>
      <text class="role-stat-label">投诉服务</text>
    </view>
  </view>

  <view wx:if="{{errorText}}" class="role-empty">
    <view class="role-empty-inner">
      <image class="role-empty-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
      <text class="role-empty-title">加载失败</text>
      <text class="role-empty-desc">{{errorText}}</text>
      <button class="role-empty-action" bindtap="load" hover-class="button-hover">
        <view class="mini-action-content">
          <image class="mini-action-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
          <text>重试</text>
        </view>
      </button>
    </view>
  </view>

  <view wx:if="{{!errorText}}" class="role-section">
    <view class="role-section-head">
      <text class="role-section-title">售后工单</text>
    </view>
    <view wx:if="{{loading}}" class="role-empty">
      <view class="role-empty-inner">
        <image class="role-empty-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
        <text class="role-empty-title">加载中…</text>
      </view>
    </view>
    <view wx:elif="{{tickets.length === 0}}" class="role-empty">
      <view class="role-empty-inner">
        <image class="role-empty-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
        <text class="role-empty-title">暂无售后工单</text>
        <text class="role-empty-desc">有售后工单时显示</text>
      </view>
    </view>
    <view wx:for="{{tickets}}" wx:key="id" class="role-card">
      <view class="role-card-head">
        <text class="role-strong">#{{item.id}} {{item.title}}</text>
        <text class="role-pill {{item.statusTone}}">{{item.statusText}}</text>
      </view>
      <text class="role-card-desc">{{item.content}}</text>
    </view>
  </view>

  <view wx:if="{{!errorText}}" class="role-section">
    <view class="role-section-head">
      <text class="role-section-title">家政服务跟踪</text>
    </view>
    <view wx:if="{{loading}}" class="role-empty">
      <view class="role-empty-inner">
        <image class="role-empty-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
        <text class="role-empty-title">加载中…</text>
      </view>
    </view>
    <view wx:elif="{{demands.length === 0}}" class="role-empty">
      <view class="role-empty-inner">
        <image class="role-empty-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
        <text class="role-empty-title">暂无家政需求</text>
        <text class="role-empty-desc">有家政需求时显示</text>
      </view>
    </view>
    <view wx:for="{{demands}}" wx:key="id" class="role-card">
      <view class="role-card-head">
        <text class="role-strong">#{{item.id}} {{item.service_type === 'maternity' ? '月嫂' : '保姆'}}</text>
        <text class="role-pill {{item.statusTone}}">{{item.statusText}}</text>
      </view>
      <text class="role-card-desc">{{item.description}}</text>
    </view>
  </view>
</view>
<role-tabbar />

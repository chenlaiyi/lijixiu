<view class="safe-page role-page promotion-dashboard-page">
  <view class="role-hero">
    <view class="role-hero-head">
      <view class="app-brand-row">
        <view class="app-logo-mark">
          <image class="app-logo-image" src="/assets/logo-mark.png" mode="aspectFit" />
        </view>
        <view class="app-brand-copy">
          <text class="role-title">推广工作台</text>
          <text class="role-subtitle">客户和佣金</text>
        </view>
      </view>
      <button class="role-ghost-btn" hover-class="button-hover" bindtap="goCustomer">
        <view class="mini-action-content">
          <image class="mini-action-icon" src="/assets/ui/receipt.png" mode="aspectFit" /><text>代下单</text>
        </view>
      </button>
    </view>
  </view>

  <view class="role-focus-strip">
    <view class="role-focus-main">
      <image class="role-focus-icon" src="/assets/ui/profile-user.png" mode="aspectFit" />
      <view class="role-focus-copy">
        <text class="role-focus-label">{{focusHint.title}}</text>
        <text class="role-focus-value">{{focusHint.desc}}</text>
      </view>
    </view>
    <text class="role-focus-chip">余额 ¥{{stats.balance}}</text>
  </view>

  <view class="role-stat-grid promotion-action-grid">
    <view class="role-stat-card role-stat-card-rich stat-customer">
      <view class="role-stat-head">
        <image class="role-stat-icon" src="/assets/ui/profile-user.png" mode="aspectFit" />
        <text class="role-stat-label">客户</text>
      </view>
      <text class="role-stat-num">{{stats.customers}}</text>
    </view>
    <view class="role-stat-card role-stat-card-rich stat-profit">
      <view class="role-stat-head">
        <image class="role-stat-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
        <text class="role-stat-label">待结算</text>
      </view>
      <text class="role-stat-num">{{stats.pending}}</text>
    </view>
    <view class="role-stat-card role-stat-card-rich stat-commission">
      <view class="role-stat-head">
        <image class="role-stat-icon" src="/assets/ui/pay.png" mode="aspectFit" />
        <text class="role-stat-label">累计</text>
      </view>
      <text class="role-stat-num">¥{{stats.commission}}</text>
    </view>
    <view class="role-stat-card role-stat-card-rich stat-balance">
      <view class="role-stat-head">
        <image class="role-stat-icon" src="/assets/ui/wallet.png" mode="aspectFit" />
        <text class="role-stat-label">可提现</text>
      </view>
      <text class="role-stat-num">¥{{stats.balance}}</text>
    </view>
  </view>

  <view wx:if="{{loadFailed}}" class="role-empty">
    <view class="role-empty-inner">
      <image class="role-empty-icon" src="/assets/ui/profile-user.png" mode="aspectFit" />
      <text class="role-empty-title">加载失败</text>
      <text class="role-empty-desc">点击重试</text>
      <button class="role-empty-action" hover-class="button-hover" bindtap="loadData">
        <view class="mini-action-content">
          <image class="mini-action-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
          <text>重试</text>
        </view>
      </button>
    </view>
  </view>

  <view wx:if="{{!loadFailed}}" class="role-section">
    <view class="role-section-head">
      <view class="role-section-copy">
        <view class="role-section-title-row">
          <image class="role-section-icon" src="/assets/ui/profile-user.png" mode="aspectFit" />
          <text class="role-section-title">客户</text>
        </view>
        <text class="role-section-subtitle">推广客户</text>
      </view>
    </view>
    <view wx:if="{{loading}}" class="role-empty">
      <view class="role-empty-inner">
        <image class="role-empty-icon" src="/assets/ui/profile-user.png" mode="aspectFit" />
        <text class="role-empty-title">加载中…</text>
      </view>
    </view>
    <view wx:if="{{customers.length === 0 && !loading}}" class="role-empty">
      <view class="role-empty-inner">
        <image class="role-empty-icon" src="/assets/ui/profile-user.png" mode="aspectFit" />
        <text class="role-empty-title">暂无客户</text>
        <text class="role-empty-desc">推广客户会显示</text>
      </view>
    </view>
    <view class="role-card" wx:for="{{customers}}" wx:key="id">
      <view class="role-card-head">
        <image class="role-card-icon" src="/assets/ui/profile-user.png" mode="aspectFit" />
        <view class="role-card-main">
          <view class="role-line">
            <text class="role-strong">{{item.displayName}}</text>
            <text class="role-pill tone-progress">客户</text>
          </view>
          <view class="role-meta-row">
            <image class="role-meta-icon" src="/assets/ui/phone.png" mode="aspectFit" />
            <text class="role-meta-text">{{item.phoneText}}</text>
          </view>
          <view class="role-meta-row">
            <image class="role-meta-icon" src="/assets/ui/profile-user.png" mode="aspectFit" />
            <text class="role-meta-text">客户 #{{item.id}}</text>
          </view>
          <view class="role-card-next">
            <text class="role-card-next-title">{{item.nextStep.title}}</text>
            <text class="role-card-next-desc">{{item.nextStep.desc}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loadFailed}}" class="role-section">
    <view class="role-section-head">
      <view class="role-section-copy">
        <view class="role-section-title-row">
          <image class="role-section-icon" src="/assets/ui/wallet.png" mode="aspectFit" />
          <text class="role-section-title">佣金</text>
        </view>
        <text class="role-section-subtitle">结算记录</text>
      </view>
    </view>
    <view wx:if="{{loading}}" class="role-empty">
      <view class="role-empty-inner">
        <image class="role-empty-icon" src="/assets/ui/wallet.png" mode="aspectFit" />
        <text class="role-empty-title">加载中…</text>
      </view>
    </view>
    <view wx:if="{{profits.length === 0 && !loading}}" class="role-empty">
      <view class="role-empty-inner">
        <image class="role-empty-icon" src="/assets/ui/wallet.png" mode="aspectFit" />
        <text class="role-empty-title">暂无佣金</text>
        <text class="role-empty-desc">订单结算后显示</text>
      </view>
    </view>
    <view class="role-card" wx:for="{{profits}}" wx:key="id">
      <view class="role-card-head">
        <image class="role-card-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
        <view class="role-card-main">
          <view class="role-line">
            <text class="role-strong">订单 #{{item.order_id}}</text>
            <text class="role-pill {{item.statusTone}}">{{item.statusText}}</text>
          </view>
          <view wx:if="{{item.created_at}}" class="role-meta-row">
            <image class="role-meta-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
            <text class="role-meta-text">{{item.created_at}}</text>
          </view>
          <view class="role-card-next">
            <text class="role-card-next-title">{{item.nextStep.title}}</text>
            <text class="role-card-next-desc">{{item.nextStep.desc}}</text>
          </view>
          <text class="role-money">¥{{item.amountText}}</text>
        </view>
      </view>
    </view>
  </view>
</view>

<role-tabbar />

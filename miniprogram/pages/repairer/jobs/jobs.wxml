<view class="safe-page jobs-page role-page">
  <view class="top-card">
    <view class="app-brand-row">
      <view class="app-logo-mark">
        <image class="app-logo-image" src="/assets/logo-mark.png" mode="aspectFit" />
      </view>
      <view class="app-brand-copy">
        <text class="title">工单</text>
        <text class="subtitle">{{repairer ? '待接与服务中' : '未绑定档案'}}</text>
      </view>
    </view>
    <button class="switch-btn" hover-class="button-hover" bindtap="goProxyOrder">
      <view class="mini-action-content">
        <image class="mini-action-icon" src="/assets/ui/receipt.png" mode="aspectFit" /><text>代下单</text>
      </view>
    </button>
  </view>

  <view class="role-stat-grid job-stat-grid">
    <view class="role-stat-card role-stat-card-rich">
      <view class="role-stat-head">
        <image class="role-stat-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
        <text class="role-stat-label">待接</text>
      </view>
      <text class="role-stat-num">{{stats.pending}}</text>
    </view>
    <view class="role-stat-card role-stat-card-rich">
      <view class="role-stat-head">
        <image class="role-stat-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
        <text class="role-stat-label">进行中</text>
      </view>
      <text class="role-stat-num">{{stats.working}}</text>
    </view>
  </view>

  <view wx:if="{{repairer}}" class="work-prompt">
    <view class="work-prompt-icon-wrap">
      <image class="work-prompt-icon" src="/assets/ui/repairer.png" mode="aspectFit" />
    </view>
    <view class="work-prompt-main">
      <text class="work-prompt-title">{{nextHint.title}}</text>
      <text class="work-prompt-desc">{{nextHint.desc}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title-row">
        <image class="section-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
        <text class="section-title">待接工单</text>
      </view>
      <text class="section-count">{{stats.pending}}</text>
    </view>
    <view wx:if="{{loading}}" class="empty">
      <image class="empty-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
      <text class="empty-title">加载中…</text>
    </view>
    <view wx:if="{{!loading && loadFailed}}" class="empty">
      <image class="empty-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
      <text class="empty-title">加载失败</text>
      <text class="empty-desc">点击重试</text>
      <button class="empty-action" hover-class="button-hover" bindtap="loadJobs">
        <view class="mini-action-content">
          <image class="mini-action-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
          <text>重试</text>
        </view>
      </button>
    </view>
    <view wx:if="{{!loading && !loadFailed && !repairer}}" class="empty">
      <image class="empty-icon" src="/assets/ui/repairer.png" mode="aspectFit" />
      <text class="empty-title">未绑定档案</text>
      <text class="empty-desc">联系门店绑定</text>
      <button class="empty-action" hover-class="button-hover" bindtap="goProxyOrder">
        <view class="mini-action-content">
          <image class="mini-action-icon" src="/assets/ui/receipt.png" mode="aspectFit" /><text>代下单</text>
        </view>
      </button>
    </view>
    <view wx:if="{{!loading && !loadFailed && repairer && orders.length === 0}}" class="empty">
      <image class="empty-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
      <text class="empty-title">暂无待接</text>
      <text class="empty-desc">派单后显示</text>
    </view>
    <block wx:if="{{!loading && !loadFailed && orders.length > 0}}">
      <view class="job-card tap-feedback" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail" hover-class="tap-feedback-active" hover-start-time="20" hover-stay-time="80">
        <view class="job-card-head">
          <image class="job-icon" src="{{item.categoryIcon}}" mode="aspectFit" />
          <view class="job-main">
            <view class="card-header">
              <text class="job-cat">{{item.categoryText}}</text>
              <text class="job-status {{item.statusTone}}">{{item.statusText}}</text>
            </view>
            <text class="job-desc">{{item.description}}</text>
            <view wx:if="{{item.mediaSummary}}" class="job-meta-row">
              <image class="job-meta-icon" src="/assets/ui/image.png" mode="aspectFit" />
              <text class="job-meta-text">{{item.mediaSummary}}</text>
            </view>
            <view wx:if="{{item.address}}" class="job-meta-row">
              <image class="job-meta-icon" src="/assets/ui/address.png" mode="aspectFit" />
              <text class="job-meta-text">{{item.address}}</text>
            </view>
          </view>
        </view>
        <view class="job-tip-row">
          <image class="job-tip-icon" src="/assets/ui/chevron-right.png" mode="aspectFit" />
          <text class="job-tip-text">素材、地址、电话</text>
        </view>
        <button class="accept-btn" catchtap="acceptOrder" data-id="{{item.id}}" data-status="{{item.status}}" hover-class="button-hover">
          <view class="job-button-content">
            <image class="job-action-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
            <text>{{item.primaryActionText}}</text>
          </view>
        </button>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title-row">
        <image class="section-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
        <text class="section-title">服务中</text>
      </view>
      <text class="section-count">{{stats.working}}</text>
    </view>
    <view wx:if="{{!loading && !loadFailed && repairer && workOrders.length === 0}}" class="empty">
      <image class="empty-icon" src="/assets/ui/bill-check.png" mode="aspectFit" />
      <text class="empty-title">暂无服务中</text>
      <text class="empty-desc">开始后显示</text>
    </view>
    <block wx:if="{{!loadFailed && workOrders.length > 0}}">
      <view class="job-card tap-feedback" wx:for="{{workOrders}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail" hover-class="tap-feedback-active" hover-start-time="20" hover-stay-time="80">
        <view class="job-card-head">
          <image class="job-icon" src="{{item.categoryIcon}}" mode="aspectFit" />
          <view class="job-main">
            <view class="card-header">
              <text class="job-cat">{{item.categoryText}}</text>
              <text class="job-status {{item.statusTone}}">{{item.statusText}}</text>
            </view>
            <text class="job-desc">{{item.description}}</text>
            <view wx:if="{{item.mediaSummary}}" class="job-meta-row">
              <image class="job-meta-icon" src="/assets/ui/image.png" mode="aspectFit" />
              <text class="job-meta-text">{{item.mediaSummary}}</text>
            </view>
            <view wx:if="{{item.address}}" class="job-meta-row">
              <image class="job-meta-icon" src="/assets/ui/address.png" mode="aspectFit" />
              <text class="job-meta-text">{{item.address}}</text>
            </view>
          </view>
        </view>
        <button class="detail-btn" catchtap="goDetail" data-id="{{item.id}}" hover-class="button-hover">
          <view class="job-button-content">
            <image class="job-action-icon" src="/assets/ui/chevron-right.png" mode="aspectFit" />
            <text>处理</text>
          </view>
        </button>
      </view>
    </block>
  </view>
</view>

<role-tabbar />

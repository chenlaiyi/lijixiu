<view class="safe-page earnings">
  <view class="balance-card">
    <view wx:if="{{isReviewExperience}}" class="experience-banner">
      <image src="/assets/ui/bill-check.png" mode="aspectFit" />
      <view>
        <text class="experience-banner-title">完整功能体验</text>
        <text class="experience-banner-desc">可提交小额提现并查看审核状态</text>
      </view>
    </view>
    <view class="balance-head">
      <view class="balance-icon-wrap">
        <image class="balance-icon" src="/assets/ui/wallet.png" mode="aspectFit" />
      </view>
      <text class="balance-label">可提现余额</text>
    </view>
    <text class="balance-amount">¥{{walletView.available_balance}}</text>
    <text class="balance-caption">{{canWithdraw ? '可提现' : '审核后入账'}}</text>
    <view class="wallet-stat-grid">
      <view class="wallet-stat-card primary">
        <text class="wallet-stat-label">可提现</text>
        <text class="wallet-stat-value">¥{{walletView.available_balance}}</text>
      </view>
      <view class="wallet-stat-card">
        <text class="wallet-stat-label">冻结中</text>
        <text class="wallet-stat-value">¥{{walletView.frozen_balance}}</text>
      </view>
      <view class="wallet-stat-card">
        <text class="wallet-stat-label">累计</text>
        <text class="wallet-stat-value">¥{{walletView.total_income}}</text>
      </view>
    </view>
    <view class="role-next-card earnings-next-card">
      <view class="role-next-icon-wrap">
        <image class="role-next-icon" src="/assets/ui/wallet.png" mode="aspectFit" />
      </view>
      <view class="role-next-copy">
        <text class="role-next-title">{{earningsHint.title}}</text>
        <text class="role-next-desc">{{earningsHint.desc}}</text>
      </view>
    </view>
    <view wx:if="{{loadWarningText}}" class="earnings-alert">
      <image class="earnings-alert-icon" src="/assets/ui/bill-file.png" mode="aspectFit" />
      <text class="earnings-alert-text">{{loadWarningText}}</text>
    </view>
    <button wx:if="{{loadFailed}}" class="retry-btn" bindtap="loadData" hover-class="button-hover">
      <view class="mini-action-content">
        <image class="mini-action-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
          <text>重试</text>
      </view>
    </button>
    <view wx:if="{{canWithdraw}}" class="withdraw-form">
      <view class="withdraw-form-head">
        <text class="withdraw-form-label">提现金额</text>
        <text wx:if="{{isReviewExperience}}" class="withdraw-form-limit">体验单次最多 ¥5.00</text>
        <text wx:else class="withdraw-form-limit">可用 ¥{{walletView.available_balance}}</text>
      </view>
      <view class="withdraw-input-row {{withdrawErrorText ? 'error' : ''}}">
        <text class="withdraw-currency">¥</text>
        <input class="withdraw-input" type="digit" maxlength="12" placeholder="0.00" value="{{withdrawAmount}}" bindinput="onWithdrawAmountInput" />
        <button wx:if="{{!isReviewExperience}}" class="withdraw-all" bindtap="useAllBalance" hover-class="button-hover">全部</button>
      </view>
      <text wx:if="{{withdrawErrorText}}" class="withdraw-error">{{withdrawErrorText}}</text>
    </view>
    <button class="withdraw-btn" bindtap="withdraw" disabled="{{loading || withdrawing || !canWithdraw}}" hover-class="button-hover">
      <image class="withdraw-icon" src="/assets/ui/wallet.png" mode="aspectFit" />
      <text>{{withdrawing ? '提交中' : '申请提现'}}</text>
    </button>
      <text class="withdraw-note">{{canWithdraw ? '提交后进入财务审核，可在流水中查看记录' : '暂无可提现'}}</text>
  </view>

  <view wx:if="{{withdrawals.length > 0}}" class="withdrawal-section">
    <view class="section-title-row">
      <image class="section-icon" src="/assets/ui/wallet.png" mode="aspectFit" />
      <view>
        <text class="section-title">提现记录</text>
        <text class="section-subtitle">申请金额与处理状态</text>
      </view>
    </view>
    <view class="withdrawal-item" wx:for="{{withdrawals}}" wx:key="id">
      <view class="withdrawal-main">
        <text class="withdrawal-amount">{{item.amountText}}</text>
        <text class="withdrawal-time">{{item.created_at}}</text>
      </view>
      <text class="withdraw-status {{item.statusClass}}">{{item.statusText}}</text>
    </view>
  </view>

  <view class="ledger-section">
    <view class="section-title-row">
      <image class="section-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
      <view>
        <text class="section-title">流水</text>
        <text class="section-subtitle">收益和提现</text>
      </view>
    </view>
    <view wx:if="{{loading && ledger.length === 0}}" class="empty">
      <image class="empty-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
      <text class="role-empty-title">加载中…</text>
    </view>
    <view wx:if="{{!loading && loadFailed && ledger.length === 0}}" class="empty">
      <image class="empty-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
      <text class="role-empty-title">加载失败</text>
      <text class="role-empty-desc">点击重试</text>
      <button class="empty-action" bindtap="loadData" hover-class="button-hover">
        <view class="mini-action-content">
          <image class="mini-action-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
          <text>重试</text>
        </view>
      </button>
    </view>
    <view wx:if="{{!loading && !loadFailed && ledger.length === 0}}" class="empty">
      <image class="empty-icon" src="/assets/ui/receipt.png" mode="aspectFit" />
      <text class="role-empty-title">暂无流水</text>
      <text class="role-empty-desc">审核后显示</text>
    </view>
    <view class="ledger-item" wx:for="{{ledger}}" wx:key="id">
      <view class="ledger-icon-wrap">
        <image class="ledger-icon" src="/assets/ui/wallet.png" mode="aspectFit" />
      </view>
      <view class="ledger-left">
        <text class="ledger-type">{{item.displayType}}</text>
        <text class="ledger-time">{{item.created_at}}</text>
      </view>
      <text class="ledger-amount {{item.amountClass}}">{{item.amountText}}</text>
    </view>
  </view>

  <button class="role-switch" bindtap="goProxyOrder" hover-class="button-hover">
    <view class="mini-action-content">
      <image class="mini-action-icon" src="/assets/ui/receipt.png" mode="aspectFit" /><text>代下单</text>
    </view>
  </button>
</view>

<role-tabbar />

  padding: 20rpx;
  color: #344054;
  background: #ffffff;
  border: 1rpx solid #e2e7e4;
  border-radius: 14rpx;
  box-shadow: none;
}

page .role-focus-chip,
page .overview-tag,
page .section-count,
page .role-pill,
page .pill,
page .job-status,
page .card-status,
page .detail-status,
page .status-badge {

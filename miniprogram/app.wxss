page .safe-page .role-card,
page .safe-page .job-card,
page .safe-page .data-card,
page .safe-page .order-card,
page .safe-page .ledger-item,
page .safe-page .info-card,
page .safe-page .bill-card,
page .safe-page .media-card,
page .safe-page .status-card,
page .safe-page .proxy-card,
page .safe-page .form-card,
page .safe-page .pay-card,
page .safe-page .profile-panel,
page .safe-page .menu-list,
page .safe-page .empty,
page .safe-page .empty-card,
page .safe-page .role-empty,
page .safe-page .next-card,
page .safe-page .next-action-card,
page .safe-page .balance-card {
  min-width: 0;
  margin-bottom: 14rpx;
  padding: 22rpx;
  color: #151b20;
  background: #ffffff;
  border: 1rpx solid #e2e7e4;
  border-radius: 14rpx;
  box-shadow: none;
}

page .role-card-head,
page .job-card-head,
page .admin-card-head,
page .card-header,
page .detail-hero-main,
page .status-top,
page .user-card {
  align-items: flex-start;
  gap: 14rpx;
}

page .role-card-icon,
page .job-icon,
page .admin-card-icon,
page .card-icon-wrap,
page .detail-icon-wrap,
page .status-icon-wrap,
page .menu-icon-wrap,
page .media-icon-wrap,
page .bill-icon-wrap,
page .info-icon {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 10rpx;
  background: #f0f8f4;
  border: 0;
  border-radius: 14rpx;
}

page .role-card-icon,
page .job-icon,
page .admin-card-icon {
  object-fit: contain;
}

page .role-strong,
page .job-cat,
page .strong,
page .card-cat,
page .detail-title,
page .status-title,
page .info-value,
page .ledger-type,
page .user-name {
  color: #151b20;
  font-size: 26rpx;
  font-weight: 750;
  line-height: 1.35;
}

page .role-desc,
page .job-desc,
page .desc,
page .card-desc,
page .description,
page .detail-workflow-desc,
page .next-desc,
page .status-label,
page .info-label,
page .ledger-time,
page .user-phone,
page .user-role {
  color: #667085;
  font-size: 22rpx;
  line-height: 1.5;
}

page .role-meta-row,
page .job-meta-row,
page .admin-meta-row,
page .meta-line,
page .order-subline {
  color: #667085;
  font-size: 21rpx;
  line-height: 1.45;

}

page .safe-page .role-stat-card,
page .safe-page .metric-card,
page .safe-page .wallet-stat-card,
page .safe-page .summary-item {
  width: auto;
  min-width: 0;
  min-height: 112rpx;
  padding: 18rpx;
  color: #151b20;
  background: #ffffff;
  border: 1rpx solid #e2e7e4;
  border-radius: 14rpx;
  box-shadow: none;
}

page .role-stat-card-rich {
  gap: 12rpx;
}

page .role-stat-icon,
page .metric-icon {
  width: 32rpx;
  height: 32rpx;
}

page .role-stat-num,
page .metric-num,
page .summary-value,
page .wallet-stat-value {
  color: #151b20;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.15;
}

page .role-stat-label,
page .metric-label,
page .summary-label,
page .wallet-stat-label {
  color: #667085;
  font-size: 21rpx;
  line-height: 1.25;
}

page .role-section,
page .jobs-page .section,
page .admin-page .section,
page .ledger-section,
page .recent-section {
  margin-top: 36rpx;
}

page .role-section-head,
page .jobs-page .section-head,
page .admin-page .section-head,
page .ledger-section .section-title-row,
page .page-head {
  min-height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

page .role-section-icon,
page .section-icon {
  width: 32rpx;

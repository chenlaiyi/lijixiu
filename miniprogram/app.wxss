page {
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: #1d2939;
  background: #f6f7f9;
  box-sizing: border-box;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button {
  font-family: inherit;
  min-width: 0;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 14rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: transparent;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
  transition: opacity 0.16s ease, transform 0.16s ease;
  vertical-align: middle;
}

button::after {
  border: none;
}

button[disabled] {
  opacity: 0.62;
}

.button-hover {
  opacity: 0.82;
  transform: scale(0.985);
}

.tap-feedback {
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.tap-feedback-active {
  opacity: 0.72;
  transform: scale(0.985);
}

.safe-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  background: #f6f7f9;
}

.glass-card {
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  box-shadow: none;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  color: #087443;
  background: #e7f8ef;
  font-size: 22rpx;
  font-weight: 800;
}

.app-brand-row {
  min-width: 0;
  display: flex;
  align-items: center;
  flex: 1;
  gap: 16rpx;
}

.app-brand-copy {
  min-width: 0;
  flex: 1;
}

.app-logo-mark {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
}

.app-logo-image {
  width: 100%;
  height: 100%;
  display: block;
}

.role-page {
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
}

.role-hero {
  padding: 22rpx;
  color: #1d2939;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  box-shadow: none;
}

.role-hero-head {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.role-title {
  display: block;
  min-width: 0;
  color: #101828;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.18;
  word-break: break-all;
}

.role-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.role-ghost-btn {
  min-width: 128rpx;
  max-width: 100%;
  height: 72rpx;
  flex-shrink: 0;
  padding: 0 18rpx;
  color: #087443;
  background: #fff;
  border: 1rpx solid #bfe9d1;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.role-stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 20rpx 0;
}

.role-stat-card {
  width: calc((100% - 16rpx) / 2);
  min-width: 0;
  min-height: 104rpx;
  padding: 18rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
}

.role-stat-card-rich {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.role-stat-head,
.role-section-head,
.role-card-title-row,
.role-meta-row,
.role-button-content,
.role-empty-inner {
  display: flex;
  align-items: center;
}

.role-stat-head {
  align-items: flex-start;
  gap: 10rpx;
}

.role-stat-head .role-stat-label {
  margin-top: 0;
}

.role-stat-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin-top: 1rpx;
}

.role-stat-num {
  display: block;
  min-width: 0;
  max-width: 100%;
  color: #101828;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.12;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.role-stat-label {
  display: block;
  min-width: 0;
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.3;
  word-break: break-all;
}

.role-next-card {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  box-shadow: none;
}

.role-next-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #f2f4f7;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
}

.role-next-icon {
  width: 32rpx;
  height: 32rpx;
  display: block;
}

.role-next-copy {
  min-width: 0;
  flex: 1;
}

.role-next-title {
  display: block;
  color: #101828;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.role-next-desc {
  display: block;
  margin-top: 6rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-all;
}

.role-card-next {
  margin-top: 12rpx;
  padding: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
}

.role-card-next-title {
  display: block;
  color: #344054;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.role-card-next-desc {
  display: block;
  margin-top: 4rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
}

.role-section {
  margin-top: 24rpx;
}

.role-section-head {
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.role-section-title-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.role-section-copy {
  min-width: 0;
  flex: 1;
}

.role-section-icon {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
}

.role-section-title {
  display: block;
  min-width: 0;
  margin-bottom: 14rpx;
  color: #101828;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.3;
  word-break: break-all;
}

.role-section-head .role-section-title {
  margin-bottom: 0;
}

.role-section-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-all;
}

.role-card,
.role-empty {
  margin-bottom: 16rpx;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
}

.role-line {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.role-card-head {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 16rpx;
}

.role-card-icon {
  width: 54rpx;
  height: 54rpx;
  padding: 10rpx;
  flex-shrink: 0;
  background: #f3f6f8;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
}

.role-card-main {
  min-width: 0;
  flex: 1;
}

.role-card-title-row {
  min-width: 0;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 10rpx;
}

.role-card-title-icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.role-strong {
  min-width: 0;
  flex: 1;
  color: #101828;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.role-pill {
  flex-shrink: 0;
  max-width: 100%;
  padding: 7rpx 13rpx;
  overflow: hidden;
  color: #175cd3;
  background: #eff4ff;
  border: 1rpx solid transparent;
  border-radius: 10rpx;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-desc {
  display: block;
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.role-meta-row {
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 10rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
}

.role-meta-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  margin-top: 3rpx;
}

.role-meta-text {
  min-width: 0;
  flex: 1;
  word-break: break-all;
}

.role-money {
  display: block;
  min-width: 0;
  max-width: 100%;
  margin-top: 12rpx;
  color: #087443;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.role-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
  min-width: 0;
}

.role-primary-btn,
.role-secondary-btn {
  width: 100%;
  min-width: 0;
  min-height: 72rpx;
  padding: 0 18rpx;
  color: #fff;
  border-radius: 14rpx;
  font-size: 25rpx;
}

.role-primary-btn {
  background: #087443;
}

.role-secondary-btn {
  color: #175cd3;
  background: #eff4ff;
}

.role-button-content {
  justify-content: center;
  gap: 10rpx;
  min-width: 0;
}

.mini-action-content {
  width: 100%;
  height: 100%;
  min-height: 0;
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  line-height: 1;
}

.role-button-content text,
.mini-action-content text {
  display: block;
  min-width: 0;
  height: auto;
  overflow: hidden;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-action-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.mini-action-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.role-empty {
  color: #667085;
  text-align: center;
}

.role-empty-inner {
  min-height: 168rpx;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
}

.role-empty-icon {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.66;
}

.role-empty-title {
  display: block;
  color: #344054;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.role-empty-desc {
  display: block;
  max-width: 540rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.5;
  word-break: break-all;
}

.role-empty-action {
  min-width: 188rpx;
  max-width: 100%;
  height: 72rpx;
  margin-top: 4rpx;
  padding: 0 20rpx;
  color: #087443;
  background: #f3fbf7;
  border: 1rpx solid #bfe9d1;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.role-empty-action .mini-action-content {
  min-width: 0;
}

.role-inline-alert-text {
  word-break: break-all;
}

.role-inline-alert {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  color: #92400e;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 14rpx;
}

.role-inline-alert-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.role-inline-alert-text {
  min-width: 0;
  flex: 1;
  font-size: 24rpx;
  line-height: 1.45;
}

.tone-waiting {
  color: #175cd3 !important;
  background: #eff4ff !important;
  border-color: #b2ccff !important;
}

.tone-progress {
  color: #087443 !important;
  background: #e7f8ef !important;
  border-color: #bfe9d1 !important;
}

.tone-action {
  color: #6941c6 !important;
  background: #f4f3ff !important;
  border-color: #d9d6fe !important;
}

.tone-warning {
  color: #b54708 !important;
  background: #fffaeb !important;
  border-color: #fedf89 !important;
}

.tone-success {
  color: #027a48 !important;
  background: #ecfdf3 !important;
  border-color: #abefc6 !important;
}

.tone-danger {
  color: #b42318 !important;
  background: #fef3f2 !important;
  border-color: #fecdca !important;
}

.tone-neutral {
  color: #344054 !important;
  background: #f2f4f7 !important;
  border-color: #e5e7eb !important;
}

/* Unified mobile product system - service direct */
page {
  color: #151b20;
  background: #f7f9f8;
}

page button {
  border-radius: 14rpx;
  font-weight: 700;
}

page .safe-page {
  width: 100%;
  min-height: 100vh;
  padding: 28rpx 28rpx calc(146rpx + env(safe-area-inset-bottom));
  color: #151b20;
  background: #f7f9f8;
}

page .app-brand-row {
  gap: 14rpx;
}

page .app-logo-mark {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  overflow: hidden;
  background: transparent;
  border: 0;
  border-radius: 14rpx;
}

page .role-page .role-hero,
page .jobs-page .top-card,
page .admin-page .admin-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0;
  padding: 8rpx 0 26rpx;
  color: #151b20;
  background: transparent;
  border: 0;
  border-bottom: 1rpx solid #e2e7e4;
  border-radius: 0;
  box-shadow: none;
}

page .role-page .role-hero-head {

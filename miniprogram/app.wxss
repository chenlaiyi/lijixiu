  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.2;
}

page .role-subtitle,
page .jobs-page .subtitle,
page .admin-page .hero-desc {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.35;
}

page .role-ghost-btn,
page .jobs-page .switch-btn,
page .admin-page .client-btn {
  min-width: 132rpx;
  height: 64rpx;
  padding: 0 16rpx;

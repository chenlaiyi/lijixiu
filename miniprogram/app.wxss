  padding: 0 12rpx;
  border: 0;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

page .role-stat-grid,
page .metric-grid,
page .wallet-stat-grid,
page .orders-summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));

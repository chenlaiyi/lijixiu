<view class="address-fields">
 <text class="label">城市/区县</text>
 <picker range="{{regions}}" value="{{regionIndex}}" bindchange="selectRegion"><view class="field">{{regionText || '请选择城市/区县'}}</view></picker>
 <text class="label">搜索小区或地址</text>
 <input class="field" value="{{keyword}}" bindinput="inputEstate" disabled="{{regionIndex < 0}}" placeholder="输入未来海岸、蓝月湾，点击下方候选确定" maxlength="160" />
 <view wx:if="{{!estate && regionIndex >= 0}}" class="address-candidates">
  <view wx:for="{{neighborhoods}}" wx:key="index" class="choice" data-index="{{index}}" bindtap="selectCandidate">{{item.label}}</view>
  <text wx:if="{{!neighborhoods.length}}" class="tip">未找到已开通服务的地址，请更换关键词或联系门店</text>
 </view>
 <view wx:if="{{estate}}" class="tip">已选小区：{{estate}}（修改关键词可重新选择）</view>
 <view wx:if="{{estate}}">
  <text class="label">楼栋</text><picker range="{{buildings}}" bindchange="selectBuilding"><view class="field">{{building || '请选择楼栋'}}</view></picker>
  <text class="label">单元／道路门牌</text><picker range="{{unitLabels}}" bindchange="selectUnit" disabled="{{!building}}"><view class="field">{{unit || '请选择单元或道路门牌，无编号可选空项'}}</view></picker>
  <text class="label">房号</text><picker range="{{rooms}}" bindchange="selectRoom" disabled="{{!rooms.length}}"><view class="field">{{room || '请选择房号'}}</view></picker>
  <picker wx:if="{{addressOptions.length}}" range="{{addressOptions}}" range-key="label" bindchange="selectAddress"><view class="choice">选择完整门牌（先选楼栋可缩小范围）</view></picker>
 </view>
 <text wx:if="{{aliases}}" class="tip">同址其他写法：{{aliases}}</text>
 <text class="label">确认服务地址</text><view class="field">{{doorNumber || '请从候选逐级选择完整地址'}}</view>
 <text wx:if="{{loading}}" class="tip">地址加载中</text>
 <text wx:if="{{!loading && !regions.length && !error}}" class="tip">暂无已分配给开通门店的服务地址</text>
 <button wx:if="{{!loading}}" bindtap="load">{{error || '刷新可选服务地址'}}</button>
</view>

DATABASE_URL=sqlite+aiosqlite:///./xiulijiu.db
# 2026-08-09: 生产推荐 MySQL,部署时改这一行:
#   DATABASE_URL=mysql+aiomysql://xiulijiu:xiulijuipass@mysql:3306/xiulijiu
# (alembic 迁移脚本会自动处理 aiomysql → pymysql 转换)
APP_NAME=xiulijiu
DEBUG=true
PUBLIC_BASE_URL=https://x.iddg.cn

# 2026-08-09: MySQL 配置(本地开发用 docker compose 起)
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=xiulijiu
MYSQL_USER=xiulijiu
MYSQL_PASSWORD=xiulijuipass
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Authentication and SMS verification
AUTH_SECRET=change-me-to-a-long-random-secret
SMS_PROVIDER=debug
SMS_DEBUG_CODE=246810

# Use trial for experience builds; change to release after formal publication.
WECHAT_MINIPROGRAM_ENV_VERSION=trial
PAYMENT_ALLOW_MOCK=false

# WeChat Pay v3 / miniprogram JSAPI payment
WECHAT_PAY_APPID=wx2273201e59e280bc
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_PATH=cert/apiclient_cert.pem
WECHAT_PAY_KEY_PATH=cert/apiclient_key.pem
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=https://x.iddg.cn/api/v1/payment/wechat/notify
WECHAT_REFUND_NOTIFY_URL=https://x.iddg.cn/api/v1/payment/wechat/refund-notify
WECHAT_APP_SECRET=
WECHAT_REVIEW_ACCOUNT=
WECHAT_REVIEW_PASSWORD=
WECHAT_REVIEW_PHONE=18800000999
WECHAT_REVIEW_MIN_BALANCE=100

# WeChat merchant transfer for withdrawals.
# Requires the WeChat Pay merchant transfer product and a configured transfer scene.
WECHAT_WITHDRAW_AUTO_TRANSFER=false
WECHAT_TRANSFER_SCENE_ID=
WECHAT_TRANSFER_NOTIFY_URL=https://x.iddg.cn/api/v1/wallet/wechat/transfer-notify
WECHAT_TRANSFER_REMARK=withdrawal
WECHAT_TRANSFER_USER_RECV_PERCEPTION=withdrawal
